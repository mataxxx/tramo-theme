{%- style -%}
  {%- assign text_sel = '#shopify-section-' | append: section.id | append: ' .announcement__item' -%}
  {% render 'text-style', s: section.settings, p: 'text', sel: text_sel %}
{%- endstyle -%}

{%- liquid
  assign hold = section.settings.hold | default: 4
  assign classes = 'announcement'
  if section.settings.animate and section.blocks.size > 1
    assign classes = classes | append: ' announcement--rotate'
  endif
  if section.settings.direction == 'right'
    assign classes = classes | append: ' announcement--right'
  endif
-%}

{%- if section.blocks.size > 0 -%}
  <div
    class="{{ classes }}"
    style="--announce-bg: {{ section.settings.bg_color }};"
    data-announcement
    data-hold="{{ hold }}"
    {% if section.settings.pause_on_hover %}data-pause{% endif %}
    role="region"
    aria-label="Anuncio"
  >
    <ul class="announcement__list" role="list">
      {%- for block in section.blocks -%}
        <li class="announcement__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
  <script>
    (function () {
      var bar = document.querySelector('#shopify-section-{{ section.id }} [data-announcement]');
      if (!bar || !bar.classList.contains('announcement--rotate')) return;
      var items = bar.querySelectorAll('.announcement__item');
      var hold = (parseFloat(bar.dataset.hold) || 4) * 1000;
      var i = 0, paused = false;
      if (bar.hasAttribute('data-pause')) {
        bar.addEventListener('mouseenter', function () { paused = true; });
        bar.addEventListener('mouseleave', function () { paused = false; });
      }
      setInterval(function () {
        if (paused || document.hidden) return;
        var cur = items[i];
        i = (i + 1) % items.length;
        var next = items[i];
        cur.classList.remove('is-active');
        cur.classList.add('is-leaving');
        next.classList.add('is-active');
        setTimeout(function () { cur.classList.remove('is-leaving'); }, 700);
      }, hold + 700);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncio",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Movimiento"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Cambiar entre mensajes",
      "default": true
    },
    {
      "type": "range",
      "id": "hold",
      "label": "Segundos que se queda cada mensaje",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Hacia dónde sale el mensaje",
      "options": [
        {
          "value": "left",
          "label": "Hacia la izquierda"
        },
        {
          "value": "right",
          "label": "Hacia la derecha"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pausar al pasar el mouse",
      "default": true
    },
    {
      "type": "header",
      "content": "Texto"
    },
    {
      "type": "checkbox",
      "id": "text_custom_font",
      "label": "Usar otra fuente",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Fuente",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Tamaño en computadora",
      "min": 10,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Tamaño en móvil",
      "min": 10,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Fondo"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#263d25"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Mensaje",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Envíos a todo Costa Rica"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace (opcional)"
        }
      ]
    }
  ]
}
{% endschema %}
