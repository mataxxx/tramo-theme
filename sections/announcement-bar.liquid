{%- if section.settings.text != blank -%}
  <div class="announcement" role="region" aria-label="Anuncio">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="announcement__text">{{ section.settings.text }}</a>
    {%- else -%}
      <p class="announcement__text">{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncio",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "text", "label": "Texto", "default": "Envíos a todo el país" },
    { "type": "url", "id": "link", "label": "Enlace (opcional)" }
  ]
}
{% endschema %}
