{%- style -%}
  #shopify-section-{{ section.id }} { padding-top: {{ section.settings.space_top | default: 0 }}px; padding-bottom: {{ section.settings.space_bottom | default: 0 }}px; }
{%- endstyle -%}
{%- style -%}
  {%- assign text_sel = '#shopify-section-' | append: section.id | append: ' .category-title' -%}
  {% render 'text-style', s: section.settings, p: 'heading_style', sel: text_sel %}
{%- endstyle -%}
{%- liquid
  assign coll = section.settings.collection
  assign heading = section.settings.heading
  if heading == blank and coll != blank
    assign heading = coll.title
  endif
  if heading == blank
    assign heading = 'Colección'
  endif
-%}
<section class="category-section" data-category-section data-category-scope data-category-handle="{{ coll.handle }}" data-category-filters="{{ section.settings.filter_tags | escape }}" data-category-search="{{ section.settings.popup_search }}">
  <div class="category-heading">
    <h2 class="category-title">
      {%- if section.settings.icon != 'none' and section.settings.icon != blank -%}<span class="category-title__icon">{% render 'icon', name: section.settings.icon %}</span>{%- endif -%}
      {%- if section.settings.show_expand and coll != blank and coll.products.size > 0 -%}
        <a href="{{ coll.url }}" class="category-title__link" data-category-open data-category-title="{{ heading | escape }}" data-category-question="¿Cuál {{ section.settings.search_noun | default: 'producto' | escape }} buscas?">{{ heading }}</a>
      {%- else -%}
        {{ heading }}
      {%- endif -%}
    </h2>
    {%- if section.settings.show_expand and coll != blank and coll.products.size > 0 -%}
      <button type="button" class="category-see" data-category-open data-category-title="{{ heading | escape }}" data-category-question="¿Cuál {{ section.settings.search_noun | default: 'producto' | escape }} buscas?">
        {% render 'icon', name: 'pin' %}<span>{{ section.settings.expand_label | default: 'Ver' }}</span>
      </button>
    {%- endif -%}
  </div>

  <div class="product-rail" data-collection-rail tabindex="0" aria-label="{{ heading | escape }}">
    {%- if coll != blank and coll.products.size > 0 -%}
      {%- for product in coll.products limit: section.settings.products_to_show -%}
        <div class="product-rail__item">
          {% render 'product-card', product: product, show_quick_add: section.settings.show_quick_add %}
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <div class="product-rail__item">
          <article class="product-card product-card--placeholder">
            <div class="product-card__media">
              <div class="product-card__placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            </div>
            <div class="product-card__info">
              <h3 class="product-card__title">Nombre del producto</h3>
              <p class="product-card__subtitle">100 g</p>
              <div class="product-card__row"><div class="price"><strong class="price__current">₡0</strong></div></div>
            </div>
          </article>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if section.settings.show_expand and coll != blank and coll.products.size > 0 -%}
    <template data-category-template>
      {%- for product in coll.products limit: section.settings.expand_limit -%}
        {% render 'category-item', product: product %}
      {%- endfor -%}
    </template>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Productos por categoría",
  "tag": "div",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icono junto al título",
      "options": [
        { "value": "none", "label": "Sin icono" },
        { "value": "house-hand", "label": "Casita" },
        { "value": "globe-hand", "label": "Mundo" },
        { "value": "mortar", "label": "Molcajete" },
        { "value": "chili", "label": "Chile" },
        { "value": "leaf", "label": "Hoja" },
        { "value": "flame", "label": "Llama" },
        { "value": "star", "label": "Estrella" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "popup_search",
      "label": "Buscador en la ventana de \"Ver todo\"",
      "options": [
        { "value": "bar", "label": "Barra visible" },
        { "value": "icon", "label": "Solo lupa pequeña" }
      ],
      "default": "bar"
    },
    {
      "type": "text",
      "id": "filter_tags",
      "label": "Filtros de la ventana (etiquetas)",
      "info": "Separadas por coma. Ej: África, Asia. Se filtran por las etiquetas del producto en Shopify."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título (opcional)",
      "info": "Si lo dejas vacío se usa el nombre de la colección."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Productos a mostrar",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Mostrar botón + para agregar rápido",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Mostrar botón de búsqueda junto al título",
      "default": true
    },
    {
      "type": "text",
      "id": "search_prefix",
      "label": "Texto del botón de búsqueda",
      "info": "Se muestra: texto + nombre de la categoría. Ej: Buscar en Especias",
      "default": "Buscar en"
    },
    {
      "type": "text",
      "id": "search_noun",
      "label": "Nombre en singular para el buscador",
      "info": "Al abrir la búsqueda dirá: ¿Qué [nombre] estás buscando? Ej: especia, semilla, fruta",
      "default": "producto"
    },
    {
      "type": "checkbox",
      "id": "show_expand",
      "label": "Mostrar botón para ver toda la colección",
      "default": true
    },
    {
      "type": "text",
      "id": "expand_label",
      "label": "Texto del botón",
      "default": "Ver"
    },
    {
      "type": "range",
      "id": "expand_limit",
      "label": "Máximo de productos al expandir",
      "min": 12,
      "max": 50,
      "step": 2,
      "default": 24
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Texto del botón para volver",
      "default": "Volver al inicio"
    },
    {
      "type": "header",
      "content": "Texto: título de la categoría"
    },
    {
      "type": "checkbox",
      "id": "heading_style_custom_font",
      "label": "Usar otra fuente",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_style_font",
      "label": "Fuente",
      "default": "lora_n4"
    },
    {
      "type": "range",
      "id": "heading_style_size",
      "label": "Tamaño en computadora",
      "min": 10,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_style_size_mobile",
      "label": "Tamaño en móvil",
      "min": 10,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color",
      "id": "heading_style_color",
      "label": "Color"
    },
    {
      "type": "header",
      "content": "Espacio"
    },
    {
      "type": "range",
      "id": "space_top",
      "label": "Espacio arriba",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "space_bottom",
      "label": "Espacio abajo",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Productos por categoría"
    }
  ]
}
{% endschema %}
