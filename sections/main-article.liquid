<article class="page-width page-width--narrow">
  <header class="page-header">
    <h1>{{ article.title }}</h1>
    <p class="muted small">{{ article.published_at | time_tag: '%d/%m/%Y' }}</p>
  </header>
  {%- if article.image -%}
    {{ article.image | image_url: width: 1100 | image_tag: widths: '550, 800, 1100', sizes: '(min-width: 750px) 800px, 100vw', alt: article.image.alt }}
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>
</article>

{% schema %}
{
  "name": "Artículo",
  "settings": []
}
{% endschema %}
