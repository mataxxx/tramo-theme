<div class="drawer drawer--right" id="CartDrawer" data-drawer="cart" role="dialog" aria-modal="true" aria-label="{{ section.settings.title | escape }}" hidden>
  <div class="drawer__backdrop" data-drawer-close></div>
  <aside class="drawer__panel">
    <header class="drawer__header">
      <p class="drawer__title">{{ section.settings.title }}</p>
      <button type="button" class="icon-button" data-drawer-close aria-label="Cerrar carrito">{% render 'icon', name: 'close' %}</button>
    </header>

    <div class="cart-drawer__content" data-cart-drawer-body>
      {%- if cart.item_count == 0 -%}
        <div class="cart-empty">
          <p>{{ section.settings.empty_text }}</p>
          <button type="button" class="button" data-open="search">Buscar productos</button>
        </div>
      {%- else -%}
        <form action="{{ routes.cart_url }}" method="post" class="cart-drawer__form" data-cart-form>
          {%- if section.settings.show_secure -%}
            {% render 'secure-pay', part: 'top' %}
          {%- endif -%}
          <ul class="cart-lines">
            {%- for item in cart.items -%}
              {% render 'cart-line', item: item, index: forloop.index %}
            {%- endfor -%}
          </ul>

          <div class="cart-drawer__footer">
            {%- if section.settings.show_note -%}
              <label for="CartDrawerNote" class="field-label">Nota para tu pedido</label>
              <textarea id="CartDrawerNote" name="note" class="field" rows="2">{{ cart.note }}</textarea>
            {%- endif -%}
            {% render 'pay-step' %}
            <div class="cart-total">
              <span>Subtotal</span>
              <strong data-cart-total>{{ cart.total_price | money }}</strong>
            </div>
            {% render 'cart-cashback' %}
{%- if settings.order_mode -%}<ul class="cart-howto" role="list">
              <li>{% render 'icon', name: 'phone' %}<span><b>Pagas por SINPE Móvil</b> antes de retirar o de enviar tu pedido.</span></li>
              <li>{% render 'icon', name: 'map-pin' %}<span>Te lo enviamos por <b>Uber Flash</b>, recoges en el <b>Mercado Central</b> o va por <b>encomienda</b> a todo el país <small>(el envío se cotiza aparte)</small></span></li>
            </ul>{%- else -%}<p class="muted small">Impuestos y envío se calculan al finalizar la compra.</p>{%- endif -%}
            <button type="{% if settings.order_mode %}button{% else %}submit{% endif %}"{% unless settings.order_mode %} name="checkout"{% endunless %} class="button button--full" data-checkout-button{% if settings.order_mode %} data-order-open{% endif %}{% if settings.show_pay_methods and settings.require_pay_choice and settings.pay_methods != blank and cart.attributes['Método de pago'] == blank %} disabled{% endif %}>{{ section.settings.checkout_label }}</button>
            {%- if section.settings.show_secure and settings.order_mode != true -%}
              {% render 'secure-pay', part: 'bottom', text: section.settings.secure_text %}
            {%- endif -%}
          </div>
        </form>
      {%- endif -%}
    </div>
  </aside>
</div>

{% schema %}
{
  "name": "Carrito lateral",
  "enabled_on": { "groups": ["aside"] },
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Tu carrito" },
    { "type": "text", "id": "empty_text", "label": "Texto con carrito vacío", "default": "Tu carrito está vacío" },
    { "type": "text", "id": "checkout_label", "label": "Texto del botón de pago", "default": "Finalizar compra" },
    { "type": "checkbox", "id": "show_secure", "label": "Mostrar sello de pago seguro y métodos de pago", "default": true },
    { "type": "text", "id": "secure_text", "label": "Texto del sello", "default": "Pagos seguros en línea" },
    { "type": "checkbox", "id": "show_note", "label": "Mostrar campo de nota del pedido", "default": false }
  ]
}
{% endschema %}
