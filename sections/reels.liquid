{%- comment -%} Computadora: video flotante ya abierto (sin sonido) + botón de ayuda {%- endcomment -%}
<div class="float-dock" data-float-dock>
  {%- if section.settings.show_float != false -%}
    {%- assign fb = section.blocks.first -%}
    <div class="tv-pip" data-tv-pip>
      <button type="button" class="tv-pip__screen" data-open="reels" aria-label="Ver videos de Tramo con sonido">
        {%- if fb.settings.video != blank -%}
          <video muted loop playsinline autoplay preload="metadata" poster="{% if fb.settings.poster != blank %}{{ fb.settings.poster | image_url: width: 360 }}{% else %}{{ fb.settings.video.preview_image | image_url: width: 360 }}{% endif %}">
            {%- for source in fb.settings.video.sources -%}{%- if source.mime_type == 'video/mp4' -%}<source src="{{ source.url }}" type="video/mp4">{%- break -%}{%- endif -%}{%- endfor -%}
          </video>
        {%- elsif fb.settings.video_url != blank -%}
          <video muted loop playsinline autoplay preload="metadata" src="{{ fb.settings.video_url }}"{% if fb.settings.poster != blank %} poster="{{ fb.settings.poster | image_url: width: 360 }}"{% endif %}></video>
        {%- elsif fb.settings.poster != blank -%}
          {{ fb.settings.poster | image_url: width: 360 | image_tag: alt: '', loading: 'lazy' }}
        {%- else -%}
          <span class="tv-pip__ph" aria-hidden="true"></span>
        {%- endif -%}
        <span class="tv-pip__tap" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 11V5.5a1.5 1.5 0 0 1 3 0V10m0-1.5a1.5 1.5 0 0 1 3 0V11m0-1a1.5 1.5 0 0 1 3 0v4.5a6 6 0 0 1-6 6h-.6a5.5 5.5 0 0 1-4.3-2.1L5 15.4a1.5 1.5 0 0 1 2.3-2L9 15"/></svg></span>
        <span class="tv-pip__top"><span class="tv-pip__tag">{{ section.settings.float_label | default: 'Tramo TV' }}</span></span>
        <span class="tv-pip__bottom">
          {%- if fb.settings.heading != blank -%}<b>{{ fb.settings.heading }}</b>{%- endif -%}
          <span class="tv-pip__hint"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4Z"/><path d="m17 9 4 6M21 9l-4 6"/></svg><em class="tv-pip__hint-a">Toca para ver con sonido</em><em class="tv-pip__hint-b">Agrandar con sonido</em></span>
        </span>
      </button>
      <button type="button" class="tv-pip__min" data-tv-min aria-label="Minimizar video"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 12h12"/></svg></button>
    </div>
    <button type="button" class="float-btn float-btn--video" data-tv-restore hidden aria-label="Mostrar video de Tramo"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="13" height="14" rx="2.5"/><path d="m16 10 5-3v10l-5-3"/></svg></button>
  {%- endif -%}
  <button type="button" class="float-btn float-btn--help" data-open="help" aria-label="Ayuda"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.6 9.3a2.5 2.5 0 0 1 4.8.9c0 1.7-2.4 2.2-2.4 3.8M12 17h.01"/></svg><span>Ayuda</span></button>
</div>
<script>
  (function () {
    var dock = document.querySelector('[data-float-dock]'); if (!dock || dock._ok) return; dock._ok = true;
    var pip = dock.querySelector('[data-tv-pip]'), restore = dock.querySelector('[data-tv-restore]');
    function setMin(min) {
      if (!pip) return;
      pip.hidden = min; if (restore) restore.hidden = !min;
      var v = pip.querySelector('video'); if (v) { if (min) v.pause(); else { var p = v.play(); if (p && p.catch) p.catch(function () {}); } }
      try { sessionStorage.setItem('tramo.pip.min', min ? '1' : ''); } catch (e) {}
    }
    /* En la portada (computadora) el video vive al lado del slideshow, siempre visible */
    var slot = document.querySelector('[data-hero-tv]');
    var desk = { matches: true };
    function place() {
      if (!pip) return;
      if (slot && desk.matches) {
        if (pip.parentNode !== slot) { slot.appendChild(pip); pip.classList.add('tv-pip--inline'); pip.hidden = false; if (restore) restore.hidden = true; }
        fit();
        var v = pip.querySelector('video'); if (v && v.paused && !document.body.classList.contains('is-locked')) { var p = v.play(); if (p && p.catch) p.catch(function () {}); }
      } else if (pip.parentNode !== dock) {
        dock.insertBefore(pip, dock.firstChild); pip.classList.remove('tv-pip--inline');
      }
    }
    function fit() {
      var sl = slot && slot.parentNode.querySelector('.hero-slider');
      if (sl) slot.style.setProperty('--tv-h', sl.getBoundingClientRect().height + 'px');
    }
    if (slot) {
      if (window.ResizeObserver) { var sl0 = slot.parentNode.querySelector('.hero-slider'); if (sl0) new ResizeObserver(fit).observe(sl0); }
      place();
    }
    var start = false; try { start = sessionStorage.getItem('tramo.pip.min') === '1'; } catch (e) {}
    if (start && !(slot && desk.matches)) setMin(true);
    dock.addEventListener('click', function (e) {
      if (e.target.closest('[data-tv-min]')) { e.stopPropagation(); setMin(true); }
      else if (e.target.closest('[data-tv-restore]')) setMin(false);
    });
    /* Mientras hay una ventana abierta (videos grandes, ayuda…) el video flotante se pausa */
    if (pip && window.MutationObserver) {
      new MutationObserver(function () {
        var v = pip.querySelector('video'); if (!v || pip.hidden) return;
        if (document.body.classList.contains('is-locked')) v.pause(); else if (slot || window.matchMedia('(min-width: 750px)').matches) { var p = v.play(); if (p && p.catch) p.catch(function () {}); }
      }).observe(document.body, { attributes: true, attributeFilter: ['class'] });
    }
    /* En celular sin portada (otras páginas) no hay video flotante: no gastar datos */
    if (!slot && window.matchMedia('(max-width: 749px)').matches && pip) { var v = pip.querySelector('video'); if (v) { v.removeAttribute('autoplay'); v.pause(); v.preload = 'none'; } }
  })();
</script>
<div class="drawer drawer--center drawer--reels" id="ReelsOverlay" data-drawer="reels" role="dialog" aria-modal="true" aria-label="Videos" hidden>
  <div class="drawer__backdrop" data-drawer-close></div>
  <div class="reels-wrap" data-reels-wrap data-default-view="{{ section.settings.default_view }}" data-view="{{ section.settings.default_view }}">
    <div class="reels-bar">
      <button type="button" class="reels-bar__btn" data-reels-show-grid>
        {% render 'icon', name: 'grid' %}
        <span>{{ section.settings.all_label | default: 'Ver todos los videos' }}</span>
      </button>
      <p class="reels-bar__title" data-reels-grid-title>{{ section.settings.grid_title | default: 'Todos los videos' }}</p>
      <button type="button" class="close-button close-button--static" data-drawer-close aria-label="Cerrar videos">{% render 'icon', name: 'close' %}</button>
    </div>

    <section class="reels" data-reels>

    {%- if section.blocks.size == 0 -%}
      <div class="reel reel--empty">
        <p>Agrega videos desde el personalizador (sección "Videos").</p>
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- assign video = block.settings.video -%}
      <article class="reel" data-reel {{ block.shopify_attributes }}>
        {%- if video != blank -%}
          <video
            class="reel__video"
            muted
            loop
            playsinline
            preload="none"
            poster="{% if block.settings.poster != blank %}{{ block.settings.poster | image_url: width: 900 }}{% else %}{{ video.preview_image | image_url: width: 900 }}{% endif %}"
          >
            {%- for source in video.sources -%}
              <source src="{{ source.url }}" type="{{ source.mime_type }}">
            {%- endfor -%}
          </video>
        {%- elsif block.settings.video_url != blank -%}
          <video
            class="reel__video"
            muted
            loop
            playsinline
            preload="none"
            {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 900 }}"{% endif %}
          >
            <source src="{{ block.settings.video_url }}" type="video/mp4">
          </video>
        {%- elsif block.settings.poster != blank -%}
          {{ block.settings.poster | image_url: width: 900 | image_tag: loading: 'lazy', class: 'reel__video', alt: '' }}
        {%- else -%}
          <div class="reel__video reel__video--empty"></div>
        {%- endif -%}

        <div class="reel__gradient"></div>
        <span class="reel__paused" aria-hidden="true">{% render 'icon', name: 'play' %}</span>
        <div class="reel__bar"><span data-reel-progress></span></div>

        <div class="reel__copy">
          {%- if block.settings.kicker != blank -%}
            <small>{{ block.settings.kicker }}</small>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h2>{{ block.settings.heading }}</h2>
          {%- endif -%}
          {%- if block.settings.product != blank -%}
            <a
              href="{{ block.settings.product.url }}"
              class="button button--light button--small"
              data-quick-view="{{ block.settings.product.url }}"
              data-close-reels
            >{{ block.settings.button_label | default: 'Ver producto' }}</a>
          {%- endif -%}
        </div>

        <div class="reel__actions">
          <button type="button" class="reel__action" data-reel-like aria-pressed="false" aria-label="Me gusta">{% render 'icon', name: 'heart' %}</button>
          <button type="button" class="reel__action" data-reel-share data-share-title="{{ block.settings.heading | escape }}" data-share-url="{{ block.settings.product.url | default: routes.root_url | prepend: request.origin }}" aria-label="Compartir">{% render 'icon', name: 'send' %}</button>
          <button type="button" class="reel__action" data-reel-mute aria-label="Sonido" aria-pressed="false">
            <span data-icon-sound>{% render 'icon', name: 'sound' %}</span>
            <span data-icon-muted hidden>{% render 'icon', name: 'mute' %}</span>
          </button>
        </div>
      </article>
    {%- endfor -%}
    </section>

    <section class="reels-grid" data-reels-grid style="--reel-cols: {{ section.settings.grid_columns }};" hidden>
      {%- for block in section.blocks -%}
        {%- assign tile_video = block.settings.video -%}
        <button type="button" class="reel-tile" data-reel-tile="{{ forloop.index0 }}" aria-label="{{ block.settings.heading | escape }}">
          {%- if block.settings.poster != blank -%}
            {{ block.settings.poster | image_url: width: 400 | image_tag: widths: '200, 300, 400', sizes: '(min-width: 750px) 230px, 33vw', loading: 'lazy', class: 'reel-tile__media', alt: '' }}
          {%- elsif tile_video != blank and tile_video.preview_image != blank -%}
            {{ tile_video.preview_image | image_url: width: 400 | image_tag: widths: '200, 300, 400', sizes: '(min-width: 750px) 230px, 33vw', loading: 'lazy', class: 'reel-tile__media', alt: '' }}
          {%- elsif block.settings.video_url != blank -%}
            <video class="reel-tile__media" muted playsinline preload="metadata" src="{{ block.settings.video_url }}#t=0.1"></video>
          {%- else -%}
            <span class="reel-tile__media reel-tile__media--empty"></span>
          {%- endif -%}
          <span class="reel-tile__play">{% render 'icon', name: 'play' %}</span>
          {%- if block.settings.heading != blank -%}
            <span class="reel-tile__title">{{ block.settings.heading }}</span>
          {%- endif -%}
        </button>
      {%- endfor -%}
    </section>
  </div>
</div>

{% schema %}
{
  "name": "Videos",
  "enabled_on": { "groups": ["aside"] },
  "max_blocks": 12,
  "settings": [
    { "type": "paragraph", "content": "Cada bloque es un video vertical. Se abren desde el botón \"Videos\" de la barra inferior y del menú." },
    {
      "type": "select",
      "id": "default_view",
      "label": "Vista al abrir desde la barra inferior",
      "options": [
        { "value": "feed", "label": "Un video a la vez (pantalla completa)" },
        { "value": "grid", "label": "Cuadrícula con todos los videos" }
      ],
      "default": "feed"
    },
    { "type": "range", "id": "grid_columns", "label": "Columnas de la cuadrícula", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "text", "id": "all_label", "label": "Texto del botón \"ver todos\"", "default": "Ver todos los videos" },
    { "type": "text", "id": "grid_title", "label": "Título de la cuadrícula", "default": "Todos los videos" },
    { "type": "checkbox", "id": "show_float", "label": "Botón flotante de videos (computadora)", "default": true },
    { "type": "text", "id": "float_label", "label": "Texto del botón flotante", "default": "Tramo TV" }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (subido a Shopify)" },
        { "type": "text", "id": "video_url", "label": "O enlace directo a un video .mp4", "info": "Solo se usa si no subes un video arriba." },
        { "type": "image_picker", "id": "poster", "label": "Imagen de portada" },
        { "type": "text", "id": "kicker", "label": "Texto pequeño", "default": "Preparado al momento" },
        { "type": "text", "id": "heading", "label": "Título", "default": "Así tostamos el comino" },
        { "type": "product", "id": "product", "label": "Producto relacionado", "info": "Elige el producto: aparece el botón para llevar al cliente al artículo." },
        { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Ver producto" }
      ]
    }
  ]
}
{% endschema %}
