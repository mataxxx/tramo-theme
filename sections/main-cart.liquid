<section class="cart-page page-width" data-cart-page>
  <header class="page-header"><h1>Tu carrito</h1></header>

  {%- if cart.item_count == 0 -%}
    <div class="cart-empty">
      <p>{{ section.settings.empty_text }}</p>
      <button type="button" class="button" data-open="search">Buscar productos</button>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-page__form" data-cart-form>
      {%- if section.settings.show_secure -%}
        {% render 'secure-pay', part: 'top' %}
      {%- endif -%}
      <ul class="cart-lines">
        {%- for item in cart.items -%}
          {% render 'cart-line', item: item, index: forloop.index %}
        {%- endfor -%}
      </ul>

      <div class="cart-page__summary">
        {%- if section.settings.show_note -%}
          <label for="CartNote" class="field-label">Nota para tu pedido</label>
          <textarea id="CartNote" name="note" class="field" rows="3">{{ cart.note }}</textarea>
        {%- endif -%}
        {% render 'pay-step' %}
        {%- assign has_var = false -%}{%- for it in cart.items -%}{%- if it.product.metafields.custom.peso_variable.value == true -%}{%- assign has_var = true -%}{%- endif -%}{%- endfor -%}
        <div class="cart-total">
          <span>{% if has_var %}Subtotal aproximado{% else %}Subtotal{% endif %}</span>
          <strong>{{ cart.total_price | money_without_trailing_zeros | replace: '₡ ', '₡' }}</strong>
        </div>
        {% render 'cart-cashback' %}
{%- if settings.order_mode -%}<ul class="cart-ship" role="list" aria-label="Formas de entrega"><li>{% render 'icon', name: 'scooter' %}<span>Uber Flash</span></li><li>{% render 'icon', name: 'store' %}<span>Retiro en tienda</span></li><li>{% render 'icon', name: 'package' %}<span>Encomienda</span></li></ul>{%- else -%}<p class="muted small">Impuestos y envío se calculan al finalizar la compra.</p>{%- endif -%}
        <div class="checkout-row"><button type="{% if settings.order_mode %}button{% else %}submit{% endif %}"{% unless settings.order_mode %} name="checkout"{% endunless %} class="button button--full" data-checkout-button{% if settings.order_mode %} data-order-open{% endif %}{% if settings.show_pay_methods and settings.require_pay_choice and settings.pay_methods != blank and cart.attributes['Método de pago'] == blank %} disabled{% endif %}>{{ section.settings.checkout_label }}</button>{%- if settings.order_mode -%}<span class="checkout-row__pay" title="Pagás con SINPE Móvil"><small>Pagas con</small><img src="{{ 'sinpe-movil.png' | asset_url }}" alt="SINPE Móvil" width="360" height="262" loading="lazy"></span>{%- endif -%}</div>
        {%- if section.settings.show_secure and settings.order_mode != true -%}
          {% render 'secure-pay', part: 'bottom', text: section.settings.secure_text %}
        {%- endif -%}
      </div>
    </form>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Carrito",
  "settings": [
    { "type": "text", "id": "empty_text", "label": "Texto con carrito vacío", "default": "Tu carrito está vacío" },
    { "type": "text", "id": "checkout_label", "label": "Texto del botón de pago", "default": "Finalizar compra" },
    { "type": "checkbox", "id": "show_secure", "label": "Mostrar sello de pago seguro y métodos de pago", "default": true },
    { "type": "text", "id": "secure_text", "label": "Texto del sello", "default": "Pagos seguros en línea" },
    { "type": "checkbox", "id": "show_note", "label": "Mostrar campo de nota del pedido", "default": false }
  ]
}
{% endschema %}
