{%- style -%}
  #shopify-section-{{ section.id }} { padding-top: {{ section.settings.space_top }}px; padding-bottom: {{ section.settings.space_bottom }}px; --cat-photo-d: {{ section.settings.photo_size_desktop | default: 150 }}px; --cat-photo-m: {{ section.settings.photo_size_mobile | default: 90 }}px; }
{%- endstyle -%}
<section class="category-section cats-section">
  {%- if section.settings.heading != blank -%}<h2 class="cats-heading">{{ section.settings.heading }}</h2>{%- endif -%}
  <div class="product-rail" tabindex="0" aria-label="{{ section.settings.heading | escape }}">
    {%- for block in section.blocks -%}
      {%- assign coll = block.settings.collection -%}
      {%- assign t = block.settings.title -%}
      {%- if t == blank and coll != blank -%}{%- assign t = coll.title -%}{%- endif -%}
      {%- assign img = block.settings.image -%}
      {%- capture inner -%}
        <span class="cats-tile__media">
          {%- if img != blank -%}
            {{ img | image_url: width: 400 | image_tag: widths: '200, 400', sizes: '225px', loading: 'lazy', alt: t }}
          {%- elsif block.settings.icon_asset != blank -%}
            <img class="cats-tile__icoimg" src="{{ block.settings.icon_asset | asset_url }}" alt="" width="360" height="360" loading="lazy">
          {%- elsif block.settings.image_asset != blank -%}
            <img class="cats-tile__photo" src="{{ block.settings.image_asset | asset_url }}" alt="{{ t | escape }}" width="480" height="480" loading="lazy">
          {%- else -%}
            {% render 'icon', name: block.settings.icon %}
          {%- endif -%}
        </span>
        <span class="cats-tile__title">{{ t }}</span>
      {%- endcapture -%}
      <div class="product-rail__item cats-item cats-item--{{ forloop.index | modulo: 6 }}">
        {%- if block.settings.link != blank -%}
          <a class="cats-tile cats-tile--link" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ inner }}</a>
        {%- elsif coll != blank -%}
          <button type="button" class="cats-tile" data-search-collection="{{ coll.handle }}" data-search-title="{{ t | escape }}" data-search-question="¿Cuál {{ block.settings.search_noun | default: 'producto' | escape }} buscas?"{% if block.settings.filters != blank %} data-category-filters="{{ block.settings.filters | escape }}"{% endif %} {{ block.shopify_attributes }}>{{ inner }}</button>
        {%- else -%}
          <span class="cats-tile" {{ block.shopify_attributes }}>{{ inner }}</span>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

<div class="drawer drawer--modal drawer--cats" id="CategoriesPanel" data-drawer="categories" role="dialog" aria-modal="true" aria-label="{{ section.settings.panel_title | escape }}" hidden>
  <div class="drawer__backdrop" data-drawer-close></div>
  <section class="cats-panel">
    <div class="cats-panel__head">
      <h2>{{ section.settings.panel_title }}</h2>
      <button type="button" class="close-button close-button--static" data-drawer-close aria-label="Cerrar">{% render 'icon', name: 'close' %}</button>
    </div>
    <div class="cats-panel__grid">
      {%- for block in section.blocks -%}
        {%- assign coll = block.settings.collection -%}
        {%- assign t = block.settings.title -%}
        {%- if t == blank and coll != blank -%}{%- assign t = coll.title -%}{%- endif -%}
        {%- assign img = block.settings.image -%}
        {%- capture inner -%}
          <span class="cats-tile__media">
            {%- if img != blank -%}
              {{ img | image_url: width: 400 | image_tag: widths: '200, 400', sizes: '180px', loading: 'lazy', alt: t }}
            {%- elsif block.settings.icon_asset != blank -%}
            <img class="cats-tile__icoimg" src="{{ block.settings.icon_asset | asset_url }}" alt="" width="360" height="360" loading="lazy">
          {%- elsif block.settings.image_asset != blank -%}
              <img class="cats-tile__photo" src="{{ block.settings.image_asset | asset_url }}" alt="{{ t | escape }}" width="480" height="480" loading="lazy">
            {%- else -%}
              {% render 'icon', name: block.settings.icon %}
            {%- endif -%}
          </span>
          <span class="cats-tile__title">{{ t }}</span>
        {%- endcapture -%}
        {%- if block.settings.link != blank -%}
          <a class="cats-tile cats-tile--link" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ inner }}</a>
        {%- elsif coll != blank -%}
          <button type="button" class="cats-tile" data-search-collection="{{ coll.handle }}" data-search-title="{{ t | escape }}" data-search-question="¿Cuál {{ block.settings.search_noun | default: 'producto' | escape }} buscas?"{% if block.settings.filters != blank %} data-category-filters="{{ block.settings.filters | escape }}"{% endif %} {{ block.shopify_attributes }}>{{ inner }}</button>
        {%- else -%}
          <span class="cats-tile" {{ block.shopify_attributes }}>{{ inner }}</span>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Círculos de categoría",
  "tag": "div",
  "max_blocks": 12,
  "settings": [
    { "type": "paragraph", "content": "Un botón que abre una ventana con todas las categorías. Cada una abre su pop-up." },
    { "type": "text", "id": "button_label", "label": "Texto del botón \"Ver\"", "default": "Ver" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Compra por categoría" },
    { "type": "text", "id": "panel_title", "label": "Título de la ventana", "default": "Nuestras categorías" },
    { "type": "range", "id": "photo_size_desktop", "label": "Tamaño de las fotos en computadora", "info": "Para categorías con foto cuando hay 3 o menos.", "min": 80, "max": 320, "step": 10, "unit": "px", "default": 150 },
    { "type": "range", "id": "photo_size_mobile", "label": "Tamaño de las fotos en celular", "min": 60, "max": 130, "step": 5, "unit": "px", "default": 90 },
    { "type": "range", "id": "space_top", "label": "Espacio arriba", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "space_bottom", "label": "Espacio abajo", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "url", "id": "link", "label": "O un enlace", "info": "Para llevar al banner del especiero usa #arma-tu-especiero" },
        { "type": "text", "id": "title", "label": "Nombre (opcional)", "info": "Si lo dejas vacío usa el de la colección." },
        { "type": "image_picker", "id": "image", "label": "Foto (opcional)", "info": "Sube un PNG con fondo transparente (producto recortado). Sin foto se muestra el ícono." },
        { "type": "text", "id": "icon_asset", "label": "O ícono ilustrado del tema (nombre de archivo)", "info": "PNG transparente que se muestra sobre fondo claro. Ej: cat-queque.png" },
        { "type": "text", "id": "image_asset", "label": "O foto del tema (nombre de archivo)", "info": "Foto completa que llena el círculo. Ej: xmas-tamales-sm.jpg" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "mortar", "label": "Mortero" },
            { "value": "chili", "label": "Chile" },
            { "value": "leaf", "label": "Hoja" },
            { "value": "package", "label": "Paquete" },
            { "value": "tag", "label": "Etiqueta" },
            { "value": "house-hand", "label": "Casa" },
            { "value": "globe-hand", "label": "Mundo" },
            { "value": "rack", "label": "Especiero" },
            { "value": "tree", "label": "Navidad" },
            { "value": "cake", "label": "Queque" },
            { "value": "tamal", "label": "Tamal" }
          ],
          "default": "leaf"
        },
        { "type": "text", "id": "filters", "label": "Subcategorías (opcional)", "info": "Etiquetas de producto separadas por coma; salen como botones arriba en la ventana. Ej: Queque navideño, Tamales, Especias" },
        { "type": "text", "id": "search_noun", "label": "Palabra para la pregunta", "info": "Ej: especia → ¿Cuál especia buscas?", "default": "producto" }
      ]
    }
  ],
  "presets": [{ "name": "Círculos de categoría" }]
}
{% endschema %}
