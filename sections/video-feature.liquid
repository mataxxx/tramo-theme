{%- style -%}
  {%- assign text_sel = '#shopify-section-' | append: section.id | append: ' .video-feature__heading' -%}
  {% render 'text-style', s: section.settings, p: 'heading', sel: text_sel %}
  {%- assign text_sel = '#shopify-section-' | append: section.id | append: ' .video-feature__copy p' -%}
  {% render 'text-style', s: section.settings, p: 'text', sel: text_sel %}
{%- endstyle -%}
{%- liquid
  assign video = section.settings.video
  assign has_media = false
  if video != blank or section.settings.video_url != blank
    assign has_media = true
  endif
-%}
{%- if has_media or section.settings.poster != blank or request.design_mode -%}
  <section class="video-feature">
    <div class="video-feature__media">
      {%- if video != blank -%}
        <video
          controls
          playsinline
          preload="metadata"
          {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1200 }}"{% else %}poster="{{ video.preview_image | image_url: width: 1200 }}"{% endif %}
        >
          {%- for source in video.sources -%}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {%- endfor -%}
        </video>
      {%- elsif section.settings.video_url != blank -%}
        <video
          controls
          playsinline
          preload="metadata"
          {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1200 }}"{% endif %}
        >
          <source src="{{ section.settings.video_url }}" type="video/mp4">
        </video>
      {%- elsif section.settings.poster != blank -%}
        {{ section.settings.poster | image_url: width: 1200 | image_tag: widths: '600, 900, 1200', sizes: '(min-width: 750px) 60vw, 100vw', loading: 'lazy', alt: '' }}
      {%- else -%}
        <div class="video-feature__placeholder">
          {% render 'icon', name: 'play' %}
          <span>Video destacado de la tienda</span>
          <small>Sube un video en la configuración de esta sección</small>
        </div>
      {%- endif -%}
    </div>
    <div class="video-feature__copy">
      {%- if section.settings.kicker != blank -%}
        <small class="video-feature__kicker">{{ section.settings.kicker }}</small>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="video-feature__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="button button--light">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Video destacado",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Video (subido a Shopify)"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "O enlace directo a un video .mp4",
      "info": "Solo se usa si no subes un video arriba."
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Imagen de portada del video"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Texto pequeño",
      "default": "Desde nuestra cocina"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "El sabor empieza aquí"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Conoce cómo preparamos nuestros blends especiales al momento."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "header",
      "content": "Texto: título"
    },
    {
      "type": "checkbox",
      "id": "heading_custom_font",
      "label": "Usar otra fuente",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Fuente",
      "default": "lora_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño en computadora",
      "min": 10,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Tamaño en móvil",
      "min": 10,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color"
    },
    {
      "type": "header",
      "content": "Texto: descripción"
    },
    {
      "type": "checkbox",
      "id": "text_custom_font",
      "label": "Usar otra fuente",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Fuente",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Tamaño en computadora",
      "min": 10,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Tamaño en móvil",
      "min": 10,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color"
    }
  ],
  "presets": [
    {
      "name": "Video destacado"
    }
  ]
}
{% endschema %}
