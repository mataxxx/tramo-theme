{%- liquid
  assign video = section.settings.video
  assign has_media = false
  if video != blank or section.settings.video_url != blank
    assign has_media = true
  endif
-%}
{%- if has_media or section.settings.poster != blank or request.design_mode -%}
  <section class="video-feature">
    <div class="video-feature__media">
      {%- if video != blank -%}
        <video
          controls
          playsinline
          preload="metadata"
          {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1200 }}"{% else %}poster="{{ video.preview_image | image_url: width: 1200 }}"{% endif %}
        >
          {%- for source in video.sources -%}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {%- endfor -%}
        </video>
      {%- elsif section.settings.video_url != blank -%}
        <video
          controls
          playsinline
          preload="metadata"
          {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1200 }}"{% endif %}
        >
          <source src="{{ section.settings.video_url }}" type="video/mp4">
        </video>
      {%- elsif section.settings.poster != blank -%}
        {{ section.settings.poster | image_url: width: 1200 | image_tag: widths: '600, 900, 1200', sizes: '(min-width: 750px) 60vw, 100vw', loading: 'lazy', alt: '' }}
      {%- else -%}
        <div class="video-feature__placeholder">
          {% render 'icon', name: 'play' %}
          <span>Video destacado de la tienda</span>
          <small>Sube un video en la configuración de esta sección</small>
        </div>
      {%- endif -%}
    </div>
    <div class="video-feature__copy">
      {%- if section.settings.kicker != blank -%}
        <small class="video-feature__kicker">{{ section.settings.kicker }}</small>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="video-feature__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="button button--light">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Video destacado",
  "settings": [
    { "type": "video", "id": "video", "label": "Video (subido a Shopify)" },
    { "type": "text", "id": "video_url", "label": "O enlace directo a un video .mp4", "info": "Solo se usa si no subes un video arriba." },
    { "type": "image_picker", "id": "poster", "label": "Imagen de portada del video" },
    { "type": "text", "id": "kicker", "label": "Texto pequeño", "default": "Desde nuestra cocina" },
    { "type": "text", "id": "heading", "label": "Título", "default": "El sabor empieza aquí" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Conoce cómo preparamos nuestros blends especiales al momento." },
    { "type": "text", "id": "button_label", "label": "Texto del botón" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "presets": [{ "name": "Video destacado" }]
}
{% endschema %}
