{%- style -%}
  #shopify-section-{{ section.id }} { padding-top: {{ section.settings.space_top | default: 0 }}px; padding-bottom: {{ section.settings.space_bottom | default: 0 }}px; }
  {%- assign text_sel = '#shopify-section-' | append: section.id | append: ' .category-title' -%}
  {% render 'text-style', s: section.settings, p: 'heading', sel: text_sel %}
{%- endstyle -%}
<section class="category-section duo">
  <div class="category-heading">
    <h2 class="category-title">{{ section.settings.heading }}</h2>
  </div>

  {%- for n in (1..2) -%}
    {%- liquid
      assign coll_key = 'collection_' | append: n
      assign label_key = 'label_' | append: n
      assign note_key = 'note_' | append: n
      assign noun_key = 'search_noun_' | append: n
      assign icon_key = 'icon_' | append: n
      assign icon_name = section.settings[icon_key]
      assign coll = section.settings[coll_key]
      assign label = section.settings[label_key]
      if label == blank and coll != blank
        assign label = coll.title
      endif
    -%}
    <div class="duo__row" data-category-scope>
      <div class="duo__label">
        <span class="duo__label-text">
          {%- if icon_name != 'none' and icon_name != blank -%}<span class="duo__icon">{% render 'icon', name: icon_name %}</span>{%- endif -%}
          {%- if coll != blank -%}
            <a href="{{ coll.url }}" class="duo__link" data-category-open data-category-title="{{ label | escape }}" data-category-question="¿Cuál {{ section.settings[noun_key] | default: 'condimento' | escape }} buscas?">{{ label }}</a>
          {%- else -%}
            <span>{{ label }}</span>
          {%- endif -%}
        </span>
        {%- if section.settings[note_key] != blank -%}<small class="duo__note">{{ section.settings[note_key] }}</small>{%- endif -%}
      </div>
      <div class="product-rail" tabindex="0" aria-label="{{ label | escape }}">
        {%- if coll != blank and coll.products.size > 0 -%}
          {%- for product in coll.products limit: section.settings.products_to_show -%}
            <div class="product-rail__item">
              {% render 'product-card', product: product, show_quick_add: section.settings.show_quick_add %}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..3) -%}
            <div class="product-rail__item">
              <article class="product-card product-card--placeholder">
                <div class="product-card__media"><div class="product-card__placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div></div>
                <div class="product-card__info">
                  <h3 class="product-card__title">Nombre del producto</h3>
                  <div class="product-card__row"><div class="price"><strong class="price__current">₡0</strong></div></div>
                </div>
              </article>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
      {%- if coll != blank and coll.products.size > 0 -%}
        <div class="category-more">
          <button type="button" class="category-eye" data-category-open data-category-title="{{ label | escape }}" data-category-question="¿Cuál {{ section.settings[noun_key] | default: 'condimento' | escape }} buscas?">
            {% render 'icon', name: 'eye' %}
            <span>Ver todo</span>
          </button>
        </div>
        <template data-category-template>
          {%- for product in coll.products limit: 60 -%}
            <div class="category-modal__item">
              {% render 'product-card', product: product, show_quick_add: section.settings.show_quick_add %}
            </div>
          {%- endfor -%}
        </template>
      {%- endif -%}
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Condimentos (dos grupos)",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Condimentos"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Productos por grupo",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Mostrar botón + para agregar rápido",
      "default": true
    },
    {
      "type": "header",
      "content": "Grupo 1"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Colección"
    },
    {
      "type": "text",
      "id": "label_1",
      "label": "Nombre del bloque",
      "default": "Condimentos de la casa"
    },
    {
      "type": "select",
      "id": "icon_1",
      "label": "Icono",
      "options": [
        { "value": "house-hand", "label": "Casita" },
        { "value": "globe-hand", "label": "Mundo" },
        { "value": "mortar", "label": "Molcajete" },
        { "value": "chili", "label": "Chile" },
        { "value": "leaf", "label": "Hoja" },
        { "value": "flame", "label": "Llama" },
        { "value": "star", "label": "Estrella" },
        { "value": "heart", "label": "Corazón" },
        { "value": "none", "label": "Sin icono" }
      ],
      "default": "house-hand"
    },
    {
      "type": "text",
      "id": "note_1",
      "label": "Texto pequeño (opcional)",
      "default": "Hechos por nosotros"
    },
    {
      "type": "text",
      "id": "search_noun_1",
      "label": "Nombre en singular para el buscador",
      "default": "condimento"
    },
    {
      "type": "header",
      "content": "Grupo 2"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Colección"
    },
    {
      "type": "text",
      "id": "label_2",
      "label": "Nombre del bloque",
      "default": "Condimentos del mundo"
    },
    {
      "type": "select",
      "id": "icon_2",
      "label": "Icono",
      "options": [
        { "value": "house-hand", "label": "Casita" },
        { "value": "globe-hand", "label": "Mundo" },
        { "value": "mortar", "label": "Molcajete" },
        { "value": "chili", "label": "Chile" },
        { "value": "leaf", "label": "Hoja" },
        { "value": "flame", "label": "Llama" },
        { "value": "star", "label": "Estrella" },
        { "value": "heart", "label": "Corazón" },
        { "value": "none", "label": "Sin icono" }
      ],
      "default": "globe-hand"
    },
    {
      "type": "text",
      "id": "note_2",
      "label": "Texto pequeño (opcional)",
      "default": "Blends de todo el mundo"
    },
    {
      "type": "text",
      "id": "search_noun_2",
      "label": "Nombre en singular para el buscador",
      "default": "condimento"
    },
    {
      "type": "header",
      "content": "Texto: título"
    },
    {
      "type": "checkbox",
      "id": "heading_custom_font",
      "label": "Usar otra fuente",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Fuente",
      "default": "lora_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño en computadora",
      "min": 10,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Tamaño en móvil",
      "min": 10,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color"
    },
    {
      "type": "header",
      "content": "Espacio"
    },
    {
      "type": "range",
      "id": "space_top",
      "label": "Espacio arriba",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "space_bottom",
      "label": "Espacio abajo",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Condimentos (dos grupos)"
    }
  ]
}
{% endschema %}
