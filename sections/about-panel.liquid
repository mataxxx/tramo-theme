{%- style -%}
  {%- assign text_sel = '#shopify-section-' | append: section.id | append: ' .about__title' -%}
  {% render 'text-style', s: section.settings, p: 'title', sel: text_sel %}
{%- endstyle -%}
{%- assign wa = settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', '' -%}
<div class="drawer drawer--modal drawer--about" id="AboutPanel" data-drawer="about" role="dialog" aria-modal="true" aria-label="{{ section.settings.title | escape }}" hidden>
  <div class="drawer__backdrop" data-drawer-close></div>
  <article class="about">
    <button type="button" class="close-button about__close" data-drawer-close aria-label="Cerrar">{% render 'icon', name: 'close' %}</button>
    {%- if section.settings.image != blank -%}
      <div class="about__image">{{ section.settings.image | image_url: width: 1000 | image_tag: widths: '500, 750, 1000', sizes: '(min-width: 750px) 640px, 100vw', loading: 'lazy', alt: section.settings.image.alt }}</div>
    {%- endif -%}
    <div class="about__body">
      {%- if section.settings.kicker != blank -%}<p class="about__kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 class="about__title">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte about__text">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="about__facts" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}><strong>{{ block.settings.value }}</strong><span>{{ block.settings.label }}</span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <div class="about__actions">
        {%- if section.settings.show_whatsapp and wa != blank -%}
          <a class="button" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">{% render 'icon', name: 'chat' %} {{ section.settings.whatsapp_label }}</a>
        {%- endif -%}
        <button type="button" class="button button--outline" data-drawer-close>{{ section.settings.close_label }}</button>
      </div>
    </div>
  </article>
</div>

{% schema %}
{
  "name": "Quiénes somos",
  "enabled_on": { "groups": ["aside"] },
  "max_blocks": 4,
  "settings": [
    { "type": "paragraph", "content": "Se abre como ventana desde el menú y el pie de página. Se cierra con la X, tocando afuera o con el botón." },
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "kicker", "label": "Texto pequeño", "default": "Nuestra historia" },
    { "type": "text", "id": "title", "label": "Título", "default": "Quiénes somos" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Tramo San Rafael #1: especias, ingredientes y sabores desde 1946, de nuestra tradición a tu mesa.</p><p>Cuéntales aquí tu historia, cómo trabajan y qué hace especiales sus productos.</p>" },
    { "type": "checkbox", "id": "show_whatsapp", "label": "Mostrar botón de WhatsApp", "default": true },
    { "type": "text", "id": "whatsapp_label", "label": "Texto del botón de WhatsApp", "default": "Escríbenos por WhatsApp" },
    { "type": "text", "id": "close_label", "label": "Texto del botón de cerrar", "default": "Cerrar" },
    { "type": "header", "content": "Texto: título" },
    { "type": "checkbox", "id": "title_custom_font", "label": "Usar otra fuente", "default": false },
    { "type": "font_picker", "id": "title_font", "label": "Fuente", "default": "lora_n4" },
    { "type": "range", "id": "title_size", "label": "Tamaño en computadora", "min": 10, "max": 96, "step": 1, "unit": "px", "default": 38 },
    { "type": "range", "id": "title_size_mobile", "label": "Tamaño en móvil", "min": 10, "max": 72, "step": 1, "unit": "px", "default": 30 },
    { "type": "color", "id": "title_color", "label": "Color", "default": "#151914" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Dato destacado",
      "settings": [
        { "type": "text", "id": "value", "label": "Dato", "default": "1946" },
        { "type": "text", "id": "label", "label": "Descripción", "default": "Desde" }
      ]
    }
  ]
}
{% endschema %}
