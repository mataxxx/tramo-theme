{%- liquid
  assign models_coll = section.settings.models_collection
  assign spices_coll = section.settings.spices_collection
  assign jar_name = section.settings.jar_variant_name | default: 'Frasco 50 g'
  assign engrave = section.settings.engrave_product
-%}
<section class="rack" data-rack data-currency="{{ cart.currency.iso_code }}" data-cart-url="{{ routes.cart_url }}" data-engrave-max="{{ section.settings.engrave_max | default: 14 }}">
  <header class="rack-hero">
    <img class="rack-hero__seal" src="{{ 'handmade-seal.svg' | asset_url }}" alt="Hecho a mano en Costa Rica" width="120" height="120" loading="eager">
    <div>
      {%- if section.settings.kicker != blank -%}<p class="rack-kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h1 class="rack-title">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}<p class="rack-sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
  </header>

  <ol class="rack-steps" data-rack-steps>
    <li class="is-active" data-step-dot="1"><span>1</span>Modelo</li>
    <li data-step-dot="2"><span>2</span>Especias</li>
    <li data-step-dot="3"><span>3</span>Listo</li>
  </ol>

  {%- comment -%} Paso 1: modelos {%- endcomment -%}
  <div class="rack-step" data-step="1">
    <h2 class="rack-step__title">1 · Elige tu modelo</h2>
    <div class="rack-models">
      {%- if models_coll == blank or models_coll.products.size == 0 -%}
        <p class="rack-empty">Elige la colección de modelos en el personalizador (productos con la etiqueta slots-6, slots-9…).</p>
      {%- endif -%}
      {%- for p in models_coll.products -%}
        {%- assign slots = 6 -%}
        {%- for t in p.tags -%}{%- if t contains 'slots-' -%}{%- assign slots = t | remove: 'slots-' | plus: 0 -%}{%- endif -%}{%- endfor -%}
        <button type="button" class="rack-model" data-model="{{ p.id }}">
          <span class="rack-model__media">
            {%- if p.featured_image -%}
              {{ p.featured_image | image_url: width: 600 | image_tag: widths: '300, 600', sizes: '(min-width: 750px) 300px, 90vw', loading: 'lazy', alt: p.title }}
            {%- else -%}
              <span class="rack-model__draw" aria-hidden="true">
                {%- for i in (1..slots) -%}<i></i>{%- endfor -%}
              </span>
            {%- endif -%}
            <img class="rack-model__seal" src="{{ 'handmade-seal.svg' | asset_url }}" alt="" width="54" height="54" loading="lazy">
          </span>
          <span class="rack-model__name">{{ p.title }}</span>
          <span class="rack-model__meta">{{ slots }} frascos · madera hecha a mano</span>
          <span class="rack-model__price">{{ p.price | money_without_trailing_zeros }}</span>
          {%- if p.description != blank -%}<span class="rack-model__desc">{{ p.description | strip_html | truncate: 90 }}</span>{%- endif -%}
        </button>
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} Paso 2: especias {%- endcomment -%}
  <div class="rack-step" data-step="2" hidden>
    <div class="rack-step__head">
      <button type="button" class="rack-back" data-go="1">{% render 'icon', name: 'arrow-left' %}<span>Cambiar modelo</span></button>
      <h2 class="rack-step__title">2 · Llena tus frascos</h2>
    </div>
    <p class="rack-hint">Toca un espacio para elegir una especia. <button type="button" class="rack-link" data-surprise>Sorpréndeme</button></p>
    {%- if section.blocks.size > 0 -%}
      <div class="rack-kits" data-rack-kits>
        <span>Kits sugeridos:</span>
        {%- for block in section.blocks -%}
          <button type="button" class="rack-kit" data-kit="{{ block.settings.spices | escape }}" {{ block.shopify_attributes }}>{{ block.settings.name }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}
    <div class="rack-frame" data-rack-frame><div class="rack-shelf" data-rack-slots></div></div>
  </div>

  {%- comment -%} Paso 3: resumen {%- endcomment -%}
  <div class="rack-step" data-step="3" hidden>
    <div class="rack-step__head">
      <button type="button" class="rack-back" data-go="2">{% render 'icon', name: 'arrow-left' %}<span>Cambiar especias</span></button>
      <h2 class="rack-step__title">3 · Tu especiero</h2>
    </div>
    <div class="rack-summary" data-rack-summary></div>
    {%- if engrave != blank -%}
      <div class="rack-engrave">
        <label class="rack-engrave__check"><input type="checkbox" data-engrave-toggle> Grabar un nombre en la madera <strong>+{{ engrave.price | money_without_trailing_zeros }}</strong></label>
        <input type="text" class="field" data-engrave-text maxlength="{{ section.settings.engrave_max | default: 14 }}" placeholder="Ej: Familia Mora" hidden>
      </div>
    {%- endif -%}
  </div>

  <div class="rack-craft">
    <div class="rack-craft__text">
      <h2>{{ section.settings.craft_title }}</h2>
      <div class="rte">{{ section.settings.craft_text }}</div>
    </div>
    {%- if section.settings.craft_image != blank -%}
      <div class="rack-craft__media">{{ section.settings.craft_image | image_url: width: 900 | image_tag: widths: '450, 900', sizes: '(min-width: 750px) 420px, 90vw', loading: 'lazy', alt: 'Taller de madera' }}</div>
    {%- elsif section.settings.craft_video != blank -%}
      <div class="rack-craft__media"><video src="{{ section.settings.craft_video }}" muted loop playsinline autoplay></video></div>
    {%- endif -%}
  </div>

  <div class="rack-bar" data-rack-bar hidden>
    <div class="rack-bar__info"><strong data-rack-total></strong><small data-rack-progress></small></div>
    <button type="button" class="button" data-rack-next>Continuar</button>
  </div>

  <div class="rack-picker" data-rack-picker hidden role="dialog" aria-modal="true" aria-label="Elegir especia">
    <div class="rack-picker__backdrop" data-picker-close></div>
    <section class="rack-picker__panel">
      <header class="rack-picker__head">
        <h3 data-picker-title>Elige una especia</h3>
        <button type="button" class="close-button close-button--static" data-picker-close aria-label="Cerrar">{% render 'icon', name: 'close' %}</button>
      </header>
      <div class="search-field rack-picker__search">{% render 'icon', name: 'search' %}<input type="search" data-picker-search placeholder="Buscar especia..." autocomplete="off" aria-label="Buscar especia"></div>
      <div class="rack-chips" data-picker-chips></div>
      <div class="rack-picker__grid" data-picker-grid></div>
    </section>
  </div>

  <script type="application/json" data-rack-data>
    {
      "models": [
        {%- for p in models_coll.products -%}
          {%- assign slots = 6 -%}
          {%- for t in p.tags -%}{%- if t contains 'slots-' -%}{%- assign slots = t | remove: 'slots-' | plus: 0 -%}{%- endif -%}{%- endfor -%}
          {"id": {{ p.id }}, "handle": {{ p.handle | json }}, "title": {{ p.title | json }}, "variant": {{ p.selected_or_first_available_variant.id }}, "price": {{ p.price }}, "slots": {{ slots }}, "available": {{ p.available }}}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "spices": [
        {%- assign first = true -%}
        {%- for p in spices_coll.products -%}
          {%- assign jar = nil -%}
          {%- for v in p.variants -%}{%- if v.title == jar_name and v.available -%}{%- assign jar = v -%}{%- endif -%}{%- endfor -%}
          {%- if jar -%}
            {%- unless first -%},{%- endunless -%}
            {%- assign first = false -%}
            {%- assign is_prem = false -%}{%- if p.tags contains 'premium' -%}{%- assign is_prem = true -%}{%- endif -%}
            {%- assign is_hot = false -%}{%- if p.metafields.custom.picante.value -%}{%- assign is_hot = true -%}{%- endif -%}
            {"id": {{ p.id }}, "handle": {{ p.handle | json }}, "title": {{ p.title | json }}, "variant": {{ jar.id }}, "price": {{ jar.price }}, "premium": {{ is_prem }}, "hot": {{ is_hot }}, "tags": {{ p.tags | json }}, "image": {% if p.featured_image %}{{ p.featured_image | image_url: width: 240 | json }}{% else %}""{% endif %}}
          {%- endif -%}
        {%- endfor -%}
      ],
      "engrave": {% if engrave != blank %}{"variant": {{ engrave.selected_or_first_available_variant.id }}, "price": {{ engrave.price }}, "title": {{ engrave.title | json }}}{% else %}null{% endif %}
    }
  </script>
</section>
<script src="{{ 'rack.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Arma tu especiero",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Texto pequeño", "default": "Hecho a mano en Costa Rica" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Arma tu especiero" },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Elige tu modelo, llénalo con tus especias favoritas y recíbelo listo para regalar o estrenar." },
    { "type": "header", "content": "Productos" },
    { "type": "collection", "id": "models_collection", "label": "Colección de modelos", "info": "Productos con la etiqueta slots-6, slots-9, slots-12… (el número = cantidad de frascos)." },
    { "type": "collection", "id": "spices_collection", "label": "Colección de especias", "info": "Productos que tengan una variante con el nombre del frasco." },
    { "type": "text", "id": "jar_variant_name", "label": "Nombre de la variante del frasco", "default": "Frasco 50 g", "info": "Debe ser igual al nombre de la variante en Shopify." },
    { "type": "product", "id": "engrave_product", "label": "Producto de grabado (opcional)" },
    { "type": "range", "id": "engrave_max", "label": "Máximo de letras del grabado", "min": 6, "max": 30, "step": 1, "default": 14 },
    { "type": "header", "content": "Hecho a mano" },
    { "type": "text", "id": "craft_title", "label": "Título", "default": "Madera tallada a mano en Costa Rica" },
    { "type": "richtext", "id": "craft_text", "label": "Texto", "default": "<p>Cada base se corta, lija y termina a mano por artesanos costarricenses. Por eso no hay dos iguales: cada especiero tiene su propia veta y su propia historia.</p>" },
    { "type": "image_picker", "id": "craft_image", "label": "Foto del taller o del artesano" },
    { "type": "text", "id": "craft_video", "label": "O enlace a un video .mp4 corto" }
  ],
  "blocks": [
    {
      "type": "kit",
      "name": "Kit sugerido",
      "settings": [
        { "type": "text", "id": "name", "label": "Nombre", "default": "Parrillero" },
        { "type": "textarea", "id": "spices", "label": "Especias (handles separados por coma)", "info": "Es la parte final de la URL del producto. Ej: comino-molido, curcuma" }
      ]
    }
  ],
  "presets": [{ "name": "Arma tu especiero" }]
}
{% endschema %}
