{%- style -%}
  {%- assign text_sel = '#shopify-section-' | append: section.id | append: ' .product-info__title' -%}
  {% render 'text-style', s: section.settings, p: 'title', sel: text_sel %}
  {%- assign text_sel = '#shopify-section-' | append: section.id | append: ' .product-info__price .price__current' -%}
  {% render 'text-style', s: section.settings, p: 'price', sel: text_sel %}
  {%- assign text_sel = '#shopify-section-' | append: section.id | append: ' .product-info__description' -%}
  {% render 'text-style', s: section.settings, p: 'desc', sel: text_sel %}
{%- endstyle -%}
{%- assign form_id = 'product-form-' | append: section.id -%}
<section class="product-page page-width" data-product-root data-section-id="{{ section.id }}">
  <div class="product-gallery" data-gallery>
    <div class="product-gallery__strip" data-gallery-strip>
      {%- for media in product.media -%}
        {%- assign loading_mode = 'lazy' -%}
        {%- if forloop.first -%}{%- assign loading_mode = 'eager' -%}{%- endif -%}
        <div class="product-gallery__slide" data-media-id="{{ media.id }}">
          {{
            media.preview_image
            | image_url: width: 1100
            | image_tag:
              widths: '450, 600, 800, 1100',
              sizes: '(min-width: 750px) 50vw, 100vw',
              loading: loading_mode,
              alt: media.alt
          }}
        </div>
      {%- else -%}
        <div class="product-gallery__slide">
          <div class="product-card__placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        </div>
      {%- endfor -%}
    </div>
    {%- if product.media.size > 1 -%}
      <ul class="product-gallery__thumbs" role="list">
        {%- for media in product.media -%}
          <li>
            <button type="button" class="thumb" data-thumb="{{ media.id }}" aria-label="Ver imagen {{ forloop.index }}">
              {{ media.preview_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <div class="product-info">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'type' -%}
          {%- if product.type != blank -%}
            <p class="eyebrow" {{ block.shopify_attributes }}>{{ product.type }}</p>
          {%- endif -%}
        {%- when 'title' -%}
          <h1 class="product-info__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>
        {%- when 'price' -%}
          <div class="product-info__price" {{ block.shopify_attributes }}>
            {% render 'price', product: product, variant: product.selected_or_first_available_variant %}
          </div>
        {%- when 'variant_picker' -%}
          <div {{ block.shopify_attributes }}>
            {% render 'product-variant-picker', product: product, form_id: form_id, section_id: section.id %}
          </div>
        {%- when 'quantity' -%}
          <div {{ block.shopify_attributes }}>
            {% render 'product-quantity', product: product %}
          </div>
        {%- when 'buy_buttons' -%}
          <div {{ block.shopify_attributes }}>
            {% render 'product-buy-button', product: product, form_id: form_id, label: block.settings.label %}
          </div>
        {%- when 'description' -%}
          {%- if product.description != blank -%}
            <div class="rte product-info__description" {{ block.shopify_attributes }}>{{ product.description }}</div>
          {%- endif -%}
        {%- when 'text' -%}
          {%- if block.settings.text != blank -%}
            <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- endif -%}
        {%- when 'collapsible' -%}
          {%- if block.settings.content != blank -%}
            <details class="collapsible" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading }}</summary>
              <div class="rte">{{ block.settings.content }}</div>
            </details>
          {%- endif -%}
        {%- when 'combo' -%}
          <div {{ block.shopify_attributes }}>
            {% render 'product-combo', product: product, title: block.settings.title, text: block.settings.text, button_label: block.settings.button_label %}
          </div>
          {%- if request.design_mode and product.metafields.custom.combo_items.value.size == 0 -%}
            <p class="small muted">Combo: este producto no tiene productos de combo asignados (campo "combo_items").</p>
          {%- endif -%}
        {%- when 'ask' -%}
          <div {{ block.shopify_attributes }}>
            {% render 'product-ask', product: product, title: block.settings.title, text: block.settings.text, placeholder: block.settings.placeholder, button_label: block.settings.button_label, chip_1: block.settings.chip_1, chip_2: block.settings.chip_2, chip_3: block.settings.chip_3, endpoint: block.settings.ai_endpoint, whatsapp_label: block.settings.whatsapp_label %}
          </div>
        {%- when '@app' -%}
          {% render block %}
      {%- endcase -%}
    {%- endfor -%}
  </div>

  {% render 'product-variants-json', product: product %}
</section>

{% schema %}
{
  "name": "Producto",
  "tag": "div",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "type",
      "name": "Categoría (tipo de producto)",
      "limit": 1
    },
    {
      "type": "title",
      "name": "Título",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Precio",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Presentaciones",
      "limit": 1
    },
    {
      "type": "quantity",
      "name": "Cantidad / granel",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Botón de compra",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Texto del botón",
          "default": "Agregar al carrito"
        }
      ]
    },
    {
      "type": "description",
      "name": "Descripción",
      "limit": 1
    },
    {
      "type": "text",
      "name": "Texto libre",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Texto adicional</p>"
        }
      ]
    },
    {
      "type": "collapsible",
      "name": "Desplegable",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Conservación"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Contenido",
          "default": "<p>Guardar en un lugar fresco y seco.</p>"
        }
      ]
    },
    {
      "type": "combo",
      "name": "Combo (por producto)",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Solo se muestra en los productos que tengan productos de combo asignados (campo del producto \"combo_items\")."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Llévalo en combo"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Agrega todo junto y ahorra."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del botón",
          "default": "Agregar combo"
        }
      ]
    },
    {
      "type": "ask",
      "name": "Preguntas (IA y WhatsApp)",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "¿Dudas sobre este producto?"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Pregúntale a nuestro asistente o escríbenos por WhatsApp."
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Texto del campo",
          "default": "Ej: ¿Para qué sirve? ¿Cómo se usa?"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del botón",
          "default": "Preguntar"
        },
        {
          "type": "text",
          "id": "chip_1",
          "label": "Pregunta sugerida 1",
          "default": "¿Cómo se usa?"
        },
        {
          "type": "text",
          "id": "chip_2",
          "label": "Pregunta sugerida 2",
          "default": "¿Con qué lo combino?"
        },
        {
          "type": "text",
          "id": "chip_3",
          "label": "Pregunta sugerida 3",
          "default": "¿Cómo se conserva?"
        },
        {
          "type": "text",
          "id": "ai_endpoint",
          "label": "Dirección del asistente IA",
          "info": "Normalmente /apps/tramo/ai. Si la vacías, las preguntas van por WhatsApp.",
          "default": "/apps/tramo/ai"
        },
        {
          "type": "text",
          "id": "whatsapp_label",
          "label": "Texto del botón de WhatsApp",
          "default": "Prefiero hablar por WhatsApp"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Texto: nombre del producto"
    },
    {
      "type": "checkbox",
      "id": "title_custom_font",
      "label": "Usar otra fuente",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Fuente",
      "default": "lora_n4"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Tamaño en computadora",
      "min": 10,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Tamaño en móvil",
      "min": 10,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color"
    },
    {
      "type": "header",
      "content": "Texto: precio"
    },
    {
      "type": "checkbox",
      "id": "price_custom_font",
      "label": "Usar otra fuente",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "price_font",
      "label": "Fuente",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "Tamaño en computadora",
      "min": 10,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "price_size_mobile",
      "label": "Tamaño en móvil",
      "min": 10,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Color"
    },
    {
      "type": "header",
      "content": "Texto: descripción"
    },
    {
      "type": "checkbox",
      "id": "desc_custom_font",
      "label": "Usar otra fuente",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "desc_font",
      "label": "Fuente",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "desc_size",
      "label": "Tamaño en computadora",
      "min": 10,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "desc_size_mobile",
      "label": "Tamaño en móvil",
      "min": 10,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Color"
    }
  ]
}
{% endschema %}
