{%- style -%}
  {%- assign text_sel = '#shopify-section-' | append: section.id | append: ' .product-info__title' -%}
  {% render 'text-style', s: section.settings, p: 'title', sel: text_sel %}
  {%- assign text_sel = '#shopify-section-' | append: section.id | append: ' .product-info__price .price__current' -%}
  {% render 'text-style', s: section.settings, p: 'price', sel: text_sel %}
  {%- assign text_sel = '#shopify-section-' | append: section.id | append: ' .product-info__description' -%}
  {% render 'text-style', s: section.settings, p: 'desc', sel: text_sel %}
{%- endstyle -%}
{%- assign form_id = 'product-form-' | append: section.id -%}
<section class="product-page page-width" data-product-root data-section-id="{{ section.id }}">
  <div class="product-gallery" data-gallery>
    <div class="product-gallery__strip" data-gallery-strip>
      {%- for media in product.media -%}
        {%- assign loading_mode = 'lazy' -%}
        {%- if forloop.first -%}{%- assign loading_mode = 'eager' -%}{%- endif -%}
        <div class="product-gallery__slide" data-media-id="{{ media.id }}">
          {{
            media.preview_image
            | image_url: width: 1100
            | image_tag:
              widths: '450, 600, 800, 1100',
              sizes: '(min-width: 750px) 50vw, 100vw',
              loading: loading_mode,
              alt: media.alt
          }}
        </div>
      {%- else -%}
        <div class="product-gallery__slide">
          <div class="product-card__placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        </div>
      {%- endfor -%}
    </div>
    {%- if product.media.size > 1 -%}
      <ul class="product-gallery__thumbs" role="list">
        {%- for media in product.media -%}
          <li>
            <button type="button" class="thumb" data-thumb="{{ media.id }}" aria-label="Ver imagen {{ forloop.index }}">
              {{ media.preview_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <div class="product-info">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'type' -%}
          {%- if product.type != blank -%}
            <p class="eyebrow" {{ block.shopify_attributes }}>{{ product.type }}</p>
          {%- endif -%}
        {%- when 'title' -%}
          <h1 class="product-info__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>
        {%- when 'price' -%}
          <div class="product-info__price" {{ block.shopify_attributes }}>
            {% render 'price', product: product, variant: product.selected_or_first_available_variant %}
          </div>
        {%- when 'variant_picker' -%}
          <div {{ block.shopify_attributes }}>
            {% render 'product-variant-picker', product: product, form_id: form_id, section_id: section.id %}
          </div>
        {%- when 'quantity' -%}
          <div {{ block.shopify_attributes }}>
            {% render 'product-quantity', product: product %}
          </div>
        {%- when 'buy_buttons' -%}
          <div {{ block.shopify_attributes }}>
            {% render 'product-buy-button', product: product, form_id: form_id, label: block.settings.label %}
          </div>
        {%- when 'description' -%}
          {%- if product.description != blank -%}
            <div class="rte product-info__description" {{ block.shopify_attributes }}>{{ product.description }}</div>
          {%- endif -%}
        {%- when 'text' -%}
          {%- if block.settings.text != blank -%}
            <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- endif -%}
        {%- when 'collapsible' -%}
          {%- if block.settings.content != blank -%}
            <details class="collapsible" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading }}</summary>
              <div class="rte">{{ block.settings.content }}</div>
            </details>
          {%- endif -%}
        {%- when 'combo' -%}
          {%- liquid
            assign combo_items = product.metafields.custom.combo_items.value
            assign combo_pct = product.metafields.custom.combo_percent.value | default: 0
            assign combo_code = product.metafields.custom.combo_code.value
          -%}
          {%- if combo_items.size > 0 -%}
            {%- liquid
              assign combo_base = product.selected_or_first_available_variant
              assign combo_total = combo_base.price
              assign combo_ids = combo_base.id | prepend: '[{"id":' | append: ',"quantity":1}'
              for it in combo_items
                assign v = it.selected_or_first_available_variant
                assign combo_total = combo_total | plus: v.price
                assign combo_ids = combo_ids | append: ',{"id":' | append: v.id | append: ',"quantity":1}'
              endfor
              assign combo_ids = combo_ids | append: ']'
              assign combo_final = combo_total
              if combo_pct > 0 and combo_code != blank
                assign rest = 100 | minus: combo_pct
                assign combo_final = combo_total | times: rest | divided_by: 100
              endif
              assign combo_count = combo_items.size | plus: 1
            -%}
            <div class="combo" data-combo data-combo-items='{{ combo_ids }}' data-combo-code="{{ combo_code | escape }}" data-combo-title="{{ block.settings.title | escape }}" data-combo-final="{{ combo_final }}" data-combo-count="{{ combo_count }}" {{ block.shopify_attributes }}>
              <p class="combo__title">{% render 'icon', name: 'tag' %} {{ block.settings.title }}</p>
              {%- if block.settings.text != blank -%}<p class="combo__text muted small">{{ block.settings.text }}</p>{%- endif -%}
              <ul class="combo__list" role="list">
                <li class="combo__item combo__item--base">
                  <span class="combo__thumb">{%- if product.featured_media -%}{{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: product.title }}{%- endif -%}</span>
                  <span class="combo__name">{{ product.title }}</span>
                </li>
                {%- for it in combo_items -%}
                  <li class="combo__item">
                    <span class="combo__plus" aria-hidden="true">+</span>
                    <span class="combo__thumb">{%- if it.featured_media -%}{{ it.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: it.title }}{%- endif -%}</span>
                    <a class="combo__name" href="{{ it.url }}">{{ it.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
              <div class="combo__total">
                <span class="combo__prices">
                  {%- if combo_final < combo_total -%}<s>{{ combo_total | money }}</s>{%- endif -%}
                  <strong>{{ combo_final | money }}</strong>
                  {%- if combo_final < combo_total -%}<em class="combo__badge">-{{ combo_pct }}%</em>{%- endif -%}
                </span>
                <button type="button" class="button" data-combo-add>{{ block.settings.button_label }}</button>
              </div>
              {%- if request.design_mode and combo_pct > 0 and combo_code == blank -%}
                <p class="small muted">Falta el código de descuento del combo (campo "combo_code" del producto) para que el descuento se aplique.</p>
              {%- endif -%}
            </div>
          {%- elsif request.design_mode -%}
            <p class="small muted" {{ block.shopify_attributes }}>Combo: este producto no tiene productos de combo asignados (campo "combo_items").</p>
          {%- endif -%}
        {%- when 'ask' -%}
          {%- assign wa = settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', '' -%}
          <div class="ask" data-ask data-endpoint="{{ block.settings.ai_endpoint | escape }}" data-wa="{{ wa }}" data-product-title="{{ product.title | escape }}" data-product-handle="{{ product.handle }}" data-product-url="{{ product.url | prepend: request.origin }}" data-product-desc="{{ product.description | strip_html | strip_newlines | truncate: 1200 | escape }}" {{ block.shopify_attributes }}>
            <p class="ask__title">{% render 'icon', name: 'sparkle' %} {{ block.settings.title }}</p>
            {%- if block.settings.text != blank -%}<p class="ask__text muted small">{{ block.settings.text }}</p>{%- endif -%}
            <div class="ask__chips">
              {%- for n in (1..3) -%}
                {%- assign chip_key = 'chip_' | append: n -%}
                {%- if block.settings[chip_key] != blank -%}
                  <button type="button" class="ask__chip" data-ask-chip>{{ block.settings[chip_key] }}</button>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <form class="ask__form" data-ask-form>
              <input type="text" name="q" required maxlength="300" placeholder="{{ block.settings.placeholder | escape }}" aria-label="Tu pregunta">
              <button type="submit" class="button">{{ block.settings.button_label }}</button>
            </form>
            <div class="ask__answer" data-ask-answer aria-live="polite" hidden></div>
            {%- if wa != blank -%}
              <a class="ask__wa" data-ask-wa href="https://wa.me/{{ wa }}?text={{ 'Hola, quiero preguntar sobre: ' | append: product.title | url_encode }}" target="_blank" rel="noopener">
                {% render 'icon', name: 'chat' %} {{ block.settings.whatsapp_label }}
              </a>
            {%- endif -%}
          </div>
        {%- when '@app' -%}
          {% render block %}
      {%- endcase -%}
    {%- endfor -%}
  </div>

  {% render 'product-variants-json', product: product %}
</section>

{% schema %}
{
  "name": "Producto",
  "tag": "div",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "type",
      "name": "Categoría (tipo de producto)",
      "limit": 1
    },
    {
      "type": "title",
      "name": "Título",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Precio",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Presentaciones",
      "limit": 1
    },
    {
      "type": "quantity",
      "name": "Cantidad / granel",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Botón de compra",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Texto del botón",
          "default": "Agregar al carrito"
        }
      ]
    },
    {
      "type": "description",
      "name": "Descripción",
      "limit": 1
    },
    {
      "type": "text",
      "name": "Texto libre",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Texto adicional</p>"
        }
      ]
    },
    {
      "type": "collapsible",
      "name": "Desplegable",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Conservación"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Contenido",
          "default": "<p>Guardar en un lugar fresco y seco.</p>"
        }
      ]
    },
    {
      "type": "combo",
      "name": "Combo (por producto)",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Solo se muestra en los productos que tengan productos de combo asignados (campo del producto \"combo_items\")."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Llévalo en combo"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Agrega todo junto y ahorra."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del botón",
          "default": "Agregar combo"
        }
      ]
    },
    {
      "type": "ask",
      "name": "Preguntas (IA y WhatsApp)",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "¿Dudas sobre este producto?"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Pregúntale a nuestro asistente o escríbenos por WhatsApp."
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Texto del campo",
          "default": "Ej: ¿Para qué sirve? ¿Cómo se usa?"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del botón",
          "default": "Preguntar"
        },
        {
          "type": "text",
          "id": "chip_1",
          "label": "Pregunta sugerida 1",
          "default": "¿Cómo se usa?"
        },
        {
          "type": "text",
          "id": "chip_2",
          "label": "Pregunta sugerida 2",
          "default": "¿Con qué lo combino?"
        },
        {
          "type": "text",
          "id": "chip_3",
          "label": "Pregunta sugerida 3",
          "default": "¿Cómo se conserva?"
        },
        {
          "type": "text",
          "id": "ai_endpoint",
          "label": "Dirección del asistente IA",
          "info": "Normalmente /apps/tramo/ai. Si la vacías, las preguntas van por WhatsApp.",
          "default": "/apps/tramo/ai"
        },
        {
          "type": "text",
          "id": "whatsapp_label",
          "label": "Texto del botón de WhatsApp",
          "default": "Prefiero hablar por WhatsApp"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Texto: nombre del producto"
    },
    {
      "type": "checkbox",
      "id": "title_custom_font",
      "label": "Usar otra fuente",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Fuente",
      "default": "lora_n4"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Tamaño en computadora",
      "min": 10,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Tamaño en móvil",
      "min": 10,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color"
    },
    {
      "type": "header",
      "content": "Texto: precio"
    },
    {
      "type": "checkbox",
      "id": "price_custom_font",
      "label": "Usar otra fuente",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "price_font",
      "label": "Fuente",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "Tamaño en computadora",
      "min": 10,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "price_size_mobile",
      "label": "Tamaño en móvil",
      "min": 10,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Color"
    },
    {
      "type": "header",
      "content": "Texto: descripción"
    },
    {
      "type": "checkbox",
      "id": "desc_custom_font",
      "label": "Usar otra fuente",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "desc_font",
      "label": "Fuente",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "desc_size",
      "label": "Tamaño en computadora",
      "min": 10,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "desc_size_mobile",
      "label": "Tamaño en móvil",
      "min": 10,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Color"
    }
  ]
}
{% endschema %}
