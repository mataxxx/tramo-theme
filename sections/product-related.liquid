<section class="page-width product-related product-related--mini">
  {% render 'product-related', product: product, title: section.settings.heading %}
</section>

{% schema %}
{
  "name": "Productos relacionados",
  "settings": [
    { "type": "paragraph", "content": "Usa los relacionados elegidos en el campo \"related\" del producto. Si no hay, muestra productos de la misma categoría." },
    { "type": "text", "id": "heading", "label": "Título", "default": "También te puede gustar" },
    { "type": "checkbox", "id": "show_quick_add", "label": "Mostrar botón + para agregar rápido", "default": true }
  ],
  "presets": [{ "name": "Productos relacionados" }]
}
{% endschema %}
