{%- style -%}
  #shopify-section-{{ section.id }} { padding-top: {{ section.settings.space_top | default: 0 }}px; padding-bottom: {{ section.settings.space_bottom | default: 0 }}px; }
{%- endstyle -%}
{%- liquid
  assign hero_height = section.settings.height_desktop
  assign hero_height_mobile = section.settings.height_mobile
-%}
{%- style -%}
  #shopify-section-{{ section.id }} .hero {
    --hero-height: {{ hero_height_mobile }}px;
    --hero-overlay: {{ section.settings.overlay_color }};
    --hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .hero { --hero-height: {{ hero_height }}px; }
  }
  {%- assign text_sel = '#shopify-section-' | append: section.id | append: ' .hero__heading' -%}
  {% render 'text-style', s: section.settings, p: 'heading', sel: text_sel %}
  {%- assign text_sel = '#shopify-section-' | append: section.id | append: ' .hero__text' -%}
  {% render 'text-style', s: section.settings, p: 'text', sel: text_sel %}
{%- endstyle -%}

<div class="hero-slider" data-hero-slider data-autoplay="{{ section.settings.autoplay_seconds }}" aria-roledescription="carrusel">
  <div class="hero-track" data-hero-track>
    {%- for i in (0..section.blocks.size) -%}
      {%- liquid
        if i == 0
          assign sl = section.settings
          assign sl_shopify = ''
        else
          assign idx = i | minus: 1
          assign blk = section.blocks[idx]
          assign sl = blk.settings
          assign sl_shopify = blk.shopify_attributes
        endif
      -%}
      <section class="hero hero--{{ section.settings.text_align }}{% if i > 0 %} hero--slide{% endif %}" aria-label="{{ sl.heading | strip_newlines | escape }}" {% if i > 0 %}style="--hero-overlay: {{ sl.overlay_color | default: '#000000' }}; --hero-overlay-opacity: {{ sl.overlay_opacity | default: 70 | divided_by: 100.0 }}"{% endif %} {{ sl_shopify }}>
        <div class="hero__media">
          {%- if sl.image != blank -%}
            {{ sl.image | image_url: width: 2000 | image_tag: widths: '750, 1100, 1500, 2000', sizes: '(min-width: 1440px) 1440px, 100vw', loading: 'eager', alt: sl.image.alt }}
          {%- elsif i == 0 -%}
            <img src="{{ 'hero-default.jpg' | asset_url }}" alt="" width="1584" height="672" loading="eager" fetchpriority="high">
          {%- else -%}
            <img src="{{ 'history-default.svg' | asset_url }}" alt="" width="1584" height="672" loading="lazy">
          {%- endif -%}
        </div>
        <div class="hero__overlay" aria-hidden="true"></div>
        <div class="hero__copy">
          {%- if sl.kicker != blank -%}<small class="hero__kicker">{{ sl.kicker }}</small>{%- endif -%}
          {%- if sl.heading != blank -%}
            <{% if i == 0 %}h1{% else %}h2{% endif %} class="hero__heading">{{ sl.heading | escape | newline_to_br }}</{% if i == 0 %}h1{% else %}h2{% endif %}>
          {%- endif -%}
          {%- if sl.text != blank -%}
            <p class="hero__text">{{ sl.text | escape | newline_to_br }}</p>
          {%- endif -%}
          {%- if sl.button_label != blank and sl.button_link != blank -%}
            <a href="{{ sl.button_link }}" class="button button--light">{{ sl.button_label }}</a>
          {%- endif -%}
        </div>
      </section>
    {%- endfor -%}
  </div>
  {%- if section.blocks.size > 0 -%}
    <div class="hero-dots" data-hero-dots>
      {%- for i in (0..section.blocks.size) -%}
        <button type="button" class="hero-dot{% if i == 0 %} is-active{% endif %}" data-hero-dot="{{ i }}" aria-label="Diapositiva {{ i | plus: 1 }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Portada (hero)",
  "tag": "div",
  "class": "section-hero",
  "max_blocks": 5,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen",
      "info": "Si la dejas vacía se usa la foto de especias incluida en el tema."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Título (admite varias líneas)",
      "default": "DE NUESTRA\nTRADICIÓN A\nTU MESA"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Especias, ingredientes\ny sabores del mundo\ndesde 1946."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Posición del texto",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        }
      ],
      "default": "left"
    },
    {
      "type": "paragraph",
      "content": "Para hacer un slideshow, agrega diapositivas abajo en \"Agregar diapositiva\". Esta de arriba es la primera."
    },
    {
      "type": "range",
      "id": "autoplay_seconds",
      "label": "Cambiar de diapositiva cada",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "s",
      "info": "0 = no cambia solo.",
      "default": 6
    },
    {
      "type": "header",
      "content": "Apariencia"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Color de la capa",
      "default": "#1e351d"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Intensidad de la capa",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 90
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Altura en computadora",
      "min": 160,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 300
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Altura en móvil",
      "min": 120,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 190
    },
    {
      "type": "header",
      "content": "Texto: título"
    },
    {
      "type": "checkbox",
      "id": "heading_custom_font",
      "label": "Usar otra fuente",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Fuente",
      "default": "lora_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño en computadora",
      "min": 10,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Tamaño en móvil",
      "min": 10,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color",
      "default": "#fffdf5"
    },
    {
      "type": "header",
      "content": "Texto: descripción"
    },
    {
      "type": "checkbox",
      "id": "text_custom_font",
      "label": "Usar otra fuente",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Fuente",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Tamaño en computadora",
      "min": 10,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Tamaño en móvil",
      "min": 10,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color",
      "default": "#fffdf5"
    },
    {
      "type": "header",
      "content": "Espacio"
    },
    {
      "type": "range",
      "id": "space_top",
      "label": "Espacio arriba",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "space_bottom",
      "label": "Espacio abajo",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Portada (hero)"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Diapositiva",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "color", "id": "overlay_color", "label": "Color del sombreado", "default": "#000000" },
        { "type": "range", "id": "overlay_opacity", "label": "Intensidad del sombreado", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 70 },
        { "type": "text", "id": "kicker", "label": "Texto pequeño" },
        { "type": "textarea", "id": "heading", "label": "Título", "default": "DESDE 1946" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Tres generaciones\nde tradición en especias." },
        { "type": "text", "id": "button_label", "label": "Texto del botón" },
        { "type": "url", "id": "button_link", "label": "Enlace del botón" }
      ]
    }
  ]
}
{% endschema %}
