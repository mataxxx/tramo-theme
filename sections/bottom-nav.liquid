<nav class="bottom-nav" aria-label="Navegación rápida">
  <button type="button" class="bottom-nav__item" data-open="help">
    {% render 'icon', name: 'help' %}
    <span>{{ section.settings.label_help }}</span>
  </button>
  <button type="button" class="bottom-nav__item bottom-nav__search" data-open="search" aria-label="{{ section.settings.label_search | escape }}">
    <span class="bottom-nav__bubble">{% render 'icon', name: 'search' %}</span>
    <span>{{ section.settings.label_search }}</span>
  </button>
  {%- if section.settings.show_videos -%}
    {%- if blogs['recetas'] != blank -%}
      <a class="bottom-nav__item" href="{{ blogs['recetas'].url }}?tab=videos">
        {% render 'icon', name: 'video' %}
        <span>{{ section.settings.label_videos }}</span>
      </a>
    {%- else -%}
      <button type="button" class="bottom-nav__item" data-open="reels">
        {% render 'icon', name: 'video' %}
        <span>{{ section.settings.label_videos }}</span>
      </button>
    {%- endif -%}
  {%- endif -%}
</nav>

{%- if section.settings.show_float_videos -%}
  <button type="button" class="float-videos" data-open="reels" aria-label="{{ section.settings.label_videos | escape }}">
    {% render 'icon', name: 'video-float' %}
    <span>{{ section.settings.label_videos }}</span>
  </button>
{%- endif -%}

{% schema %}
{
  "name": "Barra inferior móvil",
  "enabled_on": { "groups": ["aside"] },
  "settings": [
    { "type": "paragraph", "content": "Solo se muestra en celulares." },
    { "type": "text", "id": "label_home", "label": "Texto: inicio", "default": "Inicio" },
    { "type": "text", "id": "label_search", "label": "Texto: buscar", "default": "Buscar" },
    { "type": "text", "id": "label_help", "label": "Texto: ayuda", "default": "Ayuda" },
    { "type": "checkbox", "id": "show_float_videos", "label": "Botón flotante de videos (solo computadora)", "default": true },
    { "type": "checkbox", "id": "show_videos", "label": "Mostrar botón de videos", "default": true },
    { "type": "text", "id": "label_videos", "label": "Texto: videos", "default": "Videos" },
    { "type": "text", "id": "label_cart", "label": "Texto: carrito", "default": "Carrito" }
  ]
}
{% endschema %}
