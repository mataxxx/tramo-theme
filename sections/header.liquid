{%- liquid
  assign s = section.settings
    assign bg_image = false
  if s.menu_image != blank and s.menu_image_position == 'background'
    assign bg_image = true
  endif
-%}
{%- style -%}
  {%- assign text_sel = '#shopify-section-' | append: section.id | append: ' .brand-mark__title' -%}
  {% render 'text-style', s: s, p: 'brand', sel: text_sel %}
  {%- assign text_sel = '#shopify-section-' | append: section.id | append: ' .brand-mark__subtitle' -%}
  {% render 'text-style', s: s, p: 'sub', sel: text_sel %}
  {%- assign text_sel = '#shopify-section-' | append: section.id | append: ' .brand-mark__note' -%}
  {% render 'text-style', s: s, p: 'note', sel: text_sel %}
  {%- assign text_sel = '#shopify-section-' | append: section.id | append: ' .menu-list > ul > li > a' -%}
  {% render 'text-style', s: s, p: 'menu', sel: text_sel %}

  #shopify-section-{{ section.id }} .brand-mark__logo { width: {{ s.logo_width_mobile }}px; max-width: 100%; height: auto; }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .brand-mark__logo { width: {{ s.logo_width }}px; }
  }
  .drawer--left .drawer__panel { --menu-bg: {{ s.menu_bg }}; }
  {%- if bg_image %}
  .drawer--left .drawer__panel {
    background-image: linear-gradient(rgba(0,0,0,{{ s.menu_overlay | divided_by: 100.0 }}), rgba(0,0,0,{{ s.menu_overlay | divided_by: 100.0 }})), url('{{ s.menu_image | image_url: width: 900 }}');
    background-size: cover;
    background-position: center;
  }
  {%- endif %}
{%- endstyle -%}

<header class="site-header{% if s.sticky %} site-header--sticky{% endif %}" data-site-header>
  <button type="button" class="icon-button header__menu" data-open="menu" aria-label="Abrir menú" aria-controls="MenuDrawer">
    {% render 'icon', name: 'menu' %}
  </button>

  <a href="{{ routes.root_url }}" class="brand-mark" aria-label="{{ shop.name | escape }}">
    {%- if s.logo != blank -%}
      {{ s.logo | image_url: width: 800 | image_tag: widths: '200, 300, 400, 600, 800', sizes: '(min-width: 750px) 400px, 200px', class: 'brand-mark__logo', loading: 'eager', alt: shop.name }}
    {%- else -%}
      {%- if s.brand_title != blank -%}
        <strong class="brand-mark__title">{% render 'curved-text', text: s.brand_title, curve: s.brand_curve %}</strong>
      {%- else -%}
        <strong class="brand-mark__title">{% render 'curved-text', text: shop.name, curve: s.brand_curve %}</strong>
      {%- endif -%}
      {%- if s.brand_subtitle != blank -%}
        <span class="brand-mark__subtitle">{{ s.brand_subtitle }}</span>
      {%- endif -%}
      {%- if s.brand_note != blank -%}
        <small class="brand-mark__note">{{ s.brand_note }}</small>
      {%- endif -%}
    {%- endif -%}
  </a>

  <div class="header__actions">
    <button type="button" class="icon-button header__search" data-open="search" aria-label="Buscar">
      {% render 'icon', name: 'search' %}
    </button>
    {%- if s.show_account -%}
      {%- if customer -%}
        <button type="button" class="header__account header__account--in" data-open="account" aria-label="Mi cuenta">
          {% render 'icon', name: 'user' %}
          <span class="header__account-label">{{ customer.first_name | default: 'Mi cuenta' }}</span>
        </button>
      {%- else -%}
        <a href="{{ routes.storefront_login_url }}" class="header__account" aria-label="Iniciar sesión">
          {% render 'icon', name: 'user' %}
          <span class="header__account-label">Iniciar sesión</span>
        </a>
      {%- endif -%}
    {%- endif -%}
    <a href="{{ routes.cart_url }}" class="icon-button header__cart" data-open-cart aria-label="Ver carrito">
      {% render 'icon', name: 'cart' %}
      <span class="count-bubble" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
    </a>
  </div>
</header>

{%- comment -%} Panel del menú (móvil y tablet) {%- endcomment -%}
<div class="drawer drawer--left" id="MenuDrawer" data-drawer="menu" role="dialog" aria-modal="true" aria-label="Menú" hidden>
  <div class="drawer__backdrop" data-drawer-close></div>
  <aside class="drawer__panel{% if bg_image %} drawer__panel--image{% endif %}">
    <header class="drawer__header">
      <p class="drawer__title">Menú</p>
      <button type="button" class="icon-button" data-drawer-close aria-label="Cerrar menú">{% render 'icon', name: 'close' %}</button>
    </header>
    <div class="drawer__body">
      {% render 'menu-content', s: s, ctx: 'drawer' %}
    </div>
  </aside>
</div>

{% schema %}
{
  "name": "Encabezado",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Marca"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (opcional)",
      "info": "Si subes un logo, reemplaza el texto de marca."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Tamaño del logo en computadora",
      "min": 40,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Tamaño del logo en móvil",
      "min": 40,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "textarea",
      "id": "brand_title",
      "label": "Nombre (admite varias líneas)",
      "default": "TRAMO\nSAN RAFAEL #1"
    },
    {
      "type": "text",
      "id": "brand_subtitle",
      "label": "Subtítulo",
      "default": "— FUNDADORES —"
    },
    {
      "type": "text",
      "id": "brand_note",
      "label": "Nota pequeña",
      "default": "Desde 1946"
    },
    {
      "type": "range",
      "id": "brand_curve",
      "label": "Curvatura del texto de marca (estilo retro)",
      "info": "0 = recto. Sube para que el texto haga un arco.",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Texto: nombre de marca"
    },
    {
      "type": "checkbox",
      "id": "brand_custom_font",
      "label": "Usar otra fuente",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "brand_font",
      "label": "Fuente",
      "default": "lora_n4"
    },
    {
      "type": "range",
      "id": "brand_size",
      "label": "Tamaño en computadora",
      "min": 10,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "brand_size_mobile",
      "label": "Tamaño en móvil",
      "min": 10,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "brand_color",
      "label": "Color",
      "default": "#263d25"
    },
    {
      "type": "header",
      "content": "Texto: subtítulo"
    },
    {
      "type": "checkbox",
      "id": "sub_custom_font",
      "label": "Usar otra fuente",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "sub_font",
      "label": "Fuente",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "sub_size",
      "label": "Tamaño en computadora",
      "min": 10,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "sub_size_mobile",
      "label": "Tamaño en móvil",
      "min": 10,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "color",
      "id": "sub_color",
      "label": "Color",
      "default": "#263d25"
    },
    {
      "type": "header",
      "content": "Texto: nota pequeña"
    },
    {
      "type": "checkbox",
      "id": "note_custom_font",
      "label": "Usar otra fuente",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "note_font",
      "label": "Fuente",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "note_size",
      "label": "Tamaño en computadora",
      "min": 10,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "note_size_mobile",
      "label": "Tamaño en móvil",
      "min": 10,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "color",
      "id": "note_color",
      "label": "Color",
      "default": "#263d25"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Encabezado fijo al hacer scroll",
      "default": false
    },
    {
      "type": "header",
      "content": "Cuenta de usuario"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Mostrar botón de cuenta",
      "default": true
    },
    {
      "type": "header",
      "content": "Menú"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "hide_home",
      "label": "Ocultar \"Inicio\"",
      "info": "El inicio ya siempre está disponible.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_catalog",
      "label": "Ocultar \"Catálogo\"",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_contact",
      "label": "Ocultar \"Contacto\"",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_about",
      "label": "Mostrar \"Quiénes somos\" en el menú",
      "default": true
    },
    {
      "type": "text",
      "id": "about_label",
      "label": "Quiénes somos: texto",
      "default": "Quiénes somos"
    },
    {
      "type": "header",
      "content": "Colores del menú"
    },
    {
      "type": "color",
      "id": "menu_bg",
      "label": "Color de fondo del menú",
      "default": "#fffdf8"
    },
    {
      "type": "header",
      "content": "Imagen de diseño del menú"
    },
    {
      "type": "image_picker",
      "id": "menu_image",
      "label": "Imagen",
      "info": "Sirve para que el diseñador agregue una imagen decorativa al menú."
    },
    {
      "type": "select",
      "id": "menu_image_position",
      "label": "Posición de la imagen",
      "options": [
        {
          "value": "top",
          "label": "Arriba del menú"
        },
        {
          "value": "bottom",
          "label": "Abajo del menú"
        },
        {
          "value": "background",
          "label": "Como fondo del menú"
        }
      ],
      "default": "top"
    },
    {
      "type": "url",
      "id": "menu_image_link",
      "label": "Enlace de la imagen (opcional)"
    },
    {
      "type": "range",
      "id": "menu_overlay",
      "label": "Oscurecer imagen de fondo",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35,
      "info": "Solo si la imagen es de fondo, para que el texto se lea."
    },
    {
      "type": "header",
      "content": "Texto: enlaces del menú"
    },
    {
      "type": "checkbox",
      "id": "menu_custom_font",
      "label": "Usar otra fuente",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "menu_font",
      "label": "Fuente",
      "default": "lora_n4"
    },
    {
      "type": "range",
      "id": "menu_size",
      "label": "Tamaño en computadora",
      "min": 10,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "menu_size_mobile",
      "label": "Tamaño en móvil",
      "min": 10,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "menu_color",
      "label": "Color"
    }
  ]
}
{% endschema %}
