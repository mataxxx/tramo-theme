{%- style -%}
  #shopify-section-{{ section.id }} { padding-top: {{ section.settings.space_top | default: 0 }}px; padding-bottom: {{ section.settings.space_bottom | default: 0 }}px; }
{%- endstyle -%}
{%- style -%}
  #shopify-section-{{ section.id }} .site-footer {
    {%- if section.settings.bg_color != blank %} background-color: {{ section.settings.bg_color }};{% endif %}
    {%- if section.settings.bg_image != blank %} background-image: linear-gradient(rgba(0,0,0,{{ section.settings.bg_image_dim | default: 40 | divided_by: 100.0 }}), rgba(0,0,0,{{ section.settings.bg_image_dim | default: 40 | divided_by: 100.0 }})), url('{{ section.settings.bg_image | image_url: width: 2000 }}'); background-size: cover; background-position: center;{% endif %}
    {%- if section.settings.fg_color != blank %} color: {{ section.settings.fg_color }};{% endif %}
  }
  {%- assign text_sel = '#shopify-section-' | append: section.id | append: ' .footer-heading' -%}
  {% render 'text-style', s: section.settings, p: 'heading', sel: text_sel %}
  {%- assign text_sel = '#shopify-section-' | append: section.id | append: ' .site-footer .rte, #shopify-section-' | append: section.id | append: ' .footer-links a' -%}
  {% render 'text-style', s: section.settings, p: 'text', sel: text_sel %}
{%- endstyle -%}
<footer class="site-footer">
  <div class="site-footer__grid">
    {%- for block in section.blocks -%}
      {%- assign b_low = block.settings.heading | downcase -%}
      {%- if block.type == 'text' and b_low == 'contacto' -%}{%- continue -%}{%- endif -%}
      <div class="footer-block footer-block--{{ block.type }}" {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'brand' -%}
            {%- if block.settings.logo != blank -%}
              {%- assign footer_logo_style = 'width:' | append: block.settings.logo_width | append: 'px;max-width:100%;height:auto' -%}
              {{ block.settings.logo | image_url: width: 600 | image_tag: class: 'footer-logo', loading: 'lazy', alt: shop.name, style: footer_logo_style }}
            {%- elsif block.settings.logo_asset != blank -%}
              <img class="footer-logo" src="{{ block.settings.logo_asset | asset_url }}" alt="{{ shop.name | escape }}" width="600" height="600" loading="lazy" style="width:{{ block.settings.logo_width }}px;max-width:100%;height:auto">
            {%- endif -%}
            {%- if block.settings.brand_title != blank -%}
              <p class="footer-brand">{{ block.settings.brand_title | escape | newline_to_br }}</p>
            {%- endif -%}
            {%- if block.settings.brand_subtitle != blank -%}
              <p class="footer-brand__sub">{{ block.settings.brand_subtitle }}</p>
            {%- endif -%}
            {%- assign since = section.settings.since_text | default: 'Desde 1946' -%}
            {%- if since != blank and since != '-' -%}<p class="footer-brand__since">{{ since }}</p>{%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- liquid
              assign has_social = false
              if settings.whatsapp_number != blank or settings.social_instagram != blank or settings.social_facebook != blank or settings.social_tiktok != blank or settings.social_youtube != blank
                assign has_social = true
              endif
            -%}
            {%- if section.settings.show_social and has_social -%}
              <ul class="footer-social" role="list">
                {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/></svg></a></li>{%- endif -%}
                {%- if settings.whatsapp_number != blank -%}<li><a href="https://wa.me/{{ settings.whatsapp_number | strip }}" target="_blank" rel="noopener" aria-label="WhatsApp"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21l1.6-4.8A8.5 8.5 0 1 1 8 19.4L3 21Z"/><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.5-2-1-1 .8c-1-.4-2-1.4-2.4-2.4l.8-1-1-2-1.9.6Z"/></svg></a></li>{%- endif -%}
                {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8a1 1 0 0 1 1-1Z"/></svg></a></li>{%- endif -%}
                {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.3 2.4 1.9 4 4.5 4.2"/></svg></a></li>{%- endif -%}
                {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="m10 9.5 5 2.5-5 2.5Z"/></svg></a></li>{%- endif -%}
              </ul>
            {%- endif -%}
          {%- when 'menu' -%}
            <details class="footer-acc" data-footer-acc open>
            <summary class="footer-heading">{{ block.settings.heading | default: 'Tienda' }}<svg class="footer-acc__chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
            <ul class="footer-links">
              {%- assign shown = 0 -%}
              {%- if block.settings.menu != blank -%}
                {%- for link in block.settings.menu.links -%}
                  {%- assign l_low = link.title | downcase -%}{%- unless link.url contains '/search' or l_low == 'buscar' or l_low == 'búsqueda' -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- assign shown = shown | plus: 1 -%}{%- endunless -%}
                {%- endfor -%}
              {%- endif -%}
              {%- if shown == 0 -%}
                {%- assign shop_menu = section.settings.shop_menu -%}
                {%- if shop_menu == blank -%}{%- assign shop_menu = linklists['main-tramo'] -%}{%- endif -%}
                {%- if shop_menu == blank or shop_menu.links.size == 0 -%}{%- assign shop_menu = linklists['main-menu'] -%}{%- endif -%}
                {%- if shop_menu.links.size > 0 -%}
                  {%- for link in shop_menu.links limit: 8 -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
                {%- else -%}
                  {%- for c in collections limit: 7 -%}{%- if c.handle != 'all' and c.products_count > 0 -%}<li><a href="{{ c.url }}">{{ c.title }}</a></li>{%- endif -%}{%- endfor -%}
                {%- endif -%}
              {%- endif -%}
            </ul>
            </details>
          {%- when 'text' -%}
            {%- assign t_low = block.settings.heading | downcase -%}
            {%- unless t_low == 'contacto' -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="footer-heading">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- endunless -%}
        {%- endcase -%}
      </div>
    {%- endfor -%}

    {%- liquid
      assign info_menu = section.settings.info_menu
      assign info_head = section.settings.info_heading | default: 'Información'
    -%}
    <div class="footer-block footer-block--info">
      <details class="footer-acc" data-footer-acc open>
      <summary class="footer-heading">{{ info_head }}<svg class="footer-acc__chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
      <ul class="footer-links">
        {%- if info_menu != blank -%}
          {%- for link in info_menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
        {%- else -%}
          <li><button type="button" class="footer-linkbtn" data-open="about">Quiénes somos</button></li>
          {%- if settings.whatsapp_number != blank -%}<li><a href="https://wa.me/{{ settings.whatsapp_number | strip }}" rel="noopener" target="_blank">Contacto</a></li>{%- endif -%}
          {%- if shop.shipping_policy.url != blank -%}<li><a href="{{ shop.shipping_policy.url }}">Envíos y entregas</a></li>{%- endif -%}
          {%- if shop.refund_policy.url != blank -%}<li><a href="{{ shop.refund_policy.url }}">Devoluciones</a></li>{%- endif -%}
        {%- endif -%}
      </ul>
      </details>
    </div>

  </div>

  {%- if section.settings.badge_image != blank or section.settings.badge_asset != blank -%}
  <div class="site-footer__badge">
    {%- capture badge_img -%}
      {%- if section.settings.badge_image != blank -%}
        {{ section.settings.badge_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: section.settings.badge_alt, style: 'width:' | append: section.settings.badge_width | append: 'px' }}
      {%- else -%}
        <img src="{{ section.settings.badge_asset | asset_url }}" alt="{{ section.settings.badge_alt | escape }}" loading="lazy" style="width:{{ section.settings.badge_width }}px">
      {%- endif -%}
    {%- endcapture -%}
    {%- if section.settings.badge_link != blank -%}<a href="{{ section.settings.badge_link }}" target="_blank" rel="noopener">{{ badge_img }}</a>{%- else -%}{{ badge_img }}{%- endif -%}
  </div>
  {%- endif -%}

  <div class="site-footer__bottom">
    <p class="site-footer__copy">
      {%- if section.settings.copyright != blank -%}{{ section.settings.copyright }}{%- else -%}&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}{%- endif -%}
    </p>
    <div class="site-footer__legal">
      {%- if pages['privacidad'].url != blank -%}<a href="{{ pages['privacidad'].url }}">Privacidad</a>{%- elsif shop.privacy_policy.url != blank -%}<a href="{{ shop.privacy_policy.url }}">Privacidad</a>{%- endif -%}
      {%- if pages['terminos'].url != blank -%}<a href="{{ pages['terminos'].url }}">Términos y condiciones</a>{%- elsif shop.terms_of_service.url != blank -%}<a href="{{ shop.terms_of_service.url }}">Términos y condiciones</a>{%- endif -%}
      {%- if pages['aviso-legal'].url != blank -%}<a href="{{ pages['aviso-legal'].url }}">Aviso legal</a>{%- endif -%}
      {%- if section.settings.credit != blank -%}
        <span class="site-footer__credit">
          {%- if section.settings.credit_url != blank -%}<a href="{{ section.settings.credit_url }}" target="_blank" rel="noopener">{{ section.settings.credit }}</a>{%- else -%}{{ section.settings.credit }}{%- endif -%}
        </span>
      {%- endif -%}
    </div>
    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <ul class="payment-icons" role="list">
        {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>{%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Mostrar redes sociales",
      "info": "Los enlaces se configuran en Configuración del tema → Redes sociales.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Mostrar métodos de pago",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Texto de derechos (opcional)"
    },
    {
      "type": "text",
      "id": "credit",
      "label": "Crédito de desarrollo",
      "default": "Desarrollado por Nomad Studio CR"
    },
    {
      "type": "url",
      "id": "credit_url",
      "label": "Enlace del crédito (opcional)"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Menú para la columna Tienda",
      "info": "Se usa si el menú del bloque Tienda está vacío. Si no eliges ninguno se usa el menú «MAIN TRAMO»."
    },
    {
      "type": "header",
      "content": "Columna Información"
    },
    {
      "type": "text",
      "id": "info_heading",
      "label": "Título",
      "default": "Información"
    },
    {
      "type": "link_list",
      "id": "info_menu",
      "label": "Menú de Información",
      "info": "Si lo dejas vacío se muestran enlaces básicos."
    },
    {
      "type": "header",
      "content": "Marca y fondo"
    },
    {
      "type": "text",
      "id": "since_text",
      "label": "Texto bajo la marca",
      "default": "Desde 1946",
      "info": "Escribe - para ocultarlo."
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Imagen de fondo (opcional)",
      "info": "Si subes una imagen, se usa en lugar del color."
    },
    {
      "type": "range",
      "id": "bg_image_dim",
      "label": "Oscurecer la imagen",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#1a4f3b"
    },
    {
      "type": "color",
      "id": "fg_color",
      "label": "Color del texto general",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Texto: títulos de columna"
    },
    {
      "type": "checkbox",
      "id": "heading_custom_font",
      "label": "Usar otra fuente",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Fuente",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño en computadora",
      "min": 10,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Tamaño en móvil",
      "min": 10,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color"
    },
    {
      "type": "header",
      "content": "Texto: contenido y enlaces"
    },
    {
      "type": "checkbox",
      "id": "text_custom_font",
      "label": "Usar otra fuente",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Fuente",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Tamaño en computadora",
      "min": 10,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Tamaño en móvil",
      "min": 10,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color"
    },
    {
      "type": "header",
      "content": "Quiénes somos"
    },
    {
      "type": "checkbox",
      "id": "show_about",
      "label": "Mostrar enlace \"Quiénes somos\"",
      "default": true
    },
    {
      "type": "text",
      "id": "about_label",
      "label": "Texto del enlace",
      "default": "Quiénes somos"
    },
    {
      "type": "header",
      "content": "Espacio"
    },
    {
      "type": "range",
      "id": "space_top",
      "label": "Espacio arriba",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "space_bottom",
      "label": "Espacio abajo",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Sello PYME u otro sello"
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Imagen del sello",
      "info": "Ej. el sello PYME del MEIC. Se muestra al final del pie de página."
    },
    {
      "type": "text",
      "id": "badge_asset",
      "label": "O archivo del tema",
      "info": "Nombre de archivo en assets, ej. sello-pyme.png"
    },
    {
      "type": "range",
      "id": "badge_width",
      "label": "Ancho",
      "min": 60,
      "max": 240,
      "step": 5,
      "unit": "px",
      "default": 110
    },
    {
      "type": "text",
      "id": "badge_alt",
      "label": "Texto alternativo",
      "default": "Empresa PYME registrada en el MEIC"
    },
    {
      "type": "url",
      "id": "badge_link",
      "label": "Enlace (opcional)"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marca",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo (opcional)",
          "info": "Si subes un logo se muestra arriba del texto."
        },
        {
          "type": "text",
          "id": "logo_asset",
          "label": "O logo del tema (nombre de archivo)",
          "info": "Ej: logo-tramo-claro.png"
        },
        {
          "type": "range",
          "id": "logo_width",
          "label": "Tamaño del logo",
          "min": 40,
          "max": 400,
          "step": 10,
          "unit": "px",
          "default": 160
        },
        {
          "type": "textarea",
          "id": "brand_title",
          "label": "Nombre",
          "default": "TRAMO\nSAN RAFAEL #1"
        },
        {
          "type": "text",
          "id": "brand_subtitle",
          "label": "Subtítulo",
          "default": "— FUNDADORES —"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menú",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Tienda"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menú",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Contacto"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto"
        }
      ]
    }
  ]
}
{% endschema %}
