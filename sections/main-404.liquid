<section class="nf page-width">
  <img class="nf__logo" src="{{ 'logo-tramo-claro.png' | asset_url }}" alt="{{ shop.name | escape }}" width="600" height="600" loading="eager">
  <p class="nf__code">404</p>
  <h1 class="nf__title">{{ section.settings.title }}</h1>
  <p class="nf__text">{{ section.settings.text }}</p>
  <form class="nf__search" action="{{ routes.search_url }}" method="get" role="search">
    <input type="search" name="q" placeholder="Busca un producto: pasas, canela, nueces…" aria-label="Buscar productos">
    <input type="hidden" name="type" value="product">
    <button type="submit" class="button">Buscar</button>
  </form>
  <div class="nf__acts">
    <a href="{{ routes.root_url }}" class="button">Volver al inicio</a>
    {%- if settings.whatsapp_number != blank -%}
      <a href="https://wa.me/{{ settings.whatsapp_number | strip }}?text={{ 'Hola, estaba buscando algo en la tienda y no lo encontré.' | url_encode }}" class="button nf__wa" target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Página 404",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Esta página no existe" },
    { "type": "text", "id": "text", "label": "Texto", "default": "Puede que el enlace esté viejo o que el producto ya no esté disponible. Busca lo que necesitas o vuelve al inicio." }
  ]
}
{% endschema %}
