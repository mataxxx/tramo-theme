{%- layout none -%}
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>Etiqueta QR del especiero · {{ shop.name }}</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <style>
    :root { --g: #263d25; --w: #7a4a2a; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: -apple-system, system-ui, "Segoe UI", sans-serif; background: #ece7da; color: #1f2a1e; }
    .bar { display: flex; gap: 10px; align-items: center; justify-content: center; flex-wrap: wrap; padding: 16px; }
    .bar p { margin: 0; font-size: 14px; color: #55594f; }
    .bar button, .bar label { font: 600 15px/1 inherit; border-radius: 999px; padding: 12px 20px; border: 0; background: var(--g); color: #fff; cursor: pointer; }
    .bar label { background: #fff; color: #1f2a1e; border: 1px solid #d6d0bf; display: inline-flex; gap: 8px; align-items: center; }
    .bar input[type=number] { width: 48px; font: inherit; border: 0; text-align: center; }
    .sheet { display: flex; flex-wrap: wrap; gap: 6mm; justify-content: center; padding: 10px 10px 40px; }
    .label { width: 62mm; height: 90mm; background: #fffdf8; border: 1px solid #d9d2bf; border-radius: 4mm; padding: 5mm 4.5mm; display: flex; flex-direction: column; align-items: center; text-align: center; break-inside: avoid; }
    .brand { font-family: Georgia, serif; font-size: 13pt; line-height: 1; letter-spacing: .04em; color: var(--g); }
    .brand small { display: block; font: 600 5.5pt/1.4 -apple-system, system-ui, sans-serif; letter-spacing: .25em; color: #6b5a3a; margin-top: 1mm; }
    .qr { margin: 3.5mm 0 2.5mm; width: 40mm; height: 40mm; }
    .qr img, .qr canvas { width: 40mm !important; height: 40mm !important; image-rendering: pixelated; }
    h1 { font-family: Georgia, serif; font-weight: 400; font-size: 12.5pt; margin: 0; color: #1f3d22; }
    .txt { font-size: 7.5pt; line-height: 1.35; color: #4a4a42; margin: 1.5mm 0 0; }
    .code { margin-top: auto; font: 700 10pt/1 ui-monospace, Menlo, monospace; letter-spacing: .12em; padding: 1.5mm 3mm; border: 1px dashed #b9b09a; border-radius: 2mm; }
    .meta { font-size: 6.5pt; color: #6b6f66; margin-top: 1.2mm; }
    .err { max-width: 520px; margin: 40px auto; padding: 22px; background: #fff; border-radius: 16px; text-align: center; }
    .err input { width: 100%; margin-top: 12px; padding: 12px; border: 1px solid #d6d0bf; border-radius: 10px; font: 15px inherit; }
    @media print {
      body { background: #fff; }
      .bar, .err { display: none !important; }
      .sheet { padding: 0; gap: 4mm; justify-content: flex-start; }
      .label { border-color: #bbb; }
      @page { margin: 8mm; }
    }
  </style>
</head>
<body>
  <div class="bar">
    <p>Etiqueta para pegar en el especiero al empacar.</p>
    <label>Copias <input type="number" id="copies" value="1" min="1" max="20"></label>
    <button type="button" onclick="window.print()">Imprimir</button>
  </div>
  <div class="sheet" id="sheet"></div>
  <div class="err" id="err" hidden>
    <b>Falta el enlace de la etiqueta.</b>
    <p>Abre el pedido en el admin de Shopify y copia el enlace «_etiqueta_qr» del especiero. Pégalo aquí:</p>
    <input id="paste" placeholder="https://…/pages/etiqueta-especiero?d=…">
  </div>
  <script>
  (function () {
    var BASE = {{ shop.url | json }};
    function parse(d) {
      var p = String(d || '').split('~');
      if (p.length < 3 || !/^[A-Z0-9]{4}-[A-Z0-9]{4}$/.test(p[0])) return null;
      return { code: p[0], slots: parseInt(p[1], 10) || 0, jars: p[2].split('.').filter(Boolean), raw: d };
    }
    function render(info) {
      var n = Math.max(1, Math.min(20, parseInt(document.getElementById('copies').value, 10) || 1));
      var sheet = document.getElementById('sheet'); sheet.innerHTML = '';
      var url = BASE + '/pages/mi-especiero?d=' + encodeURIComponent(info.raw);
      for (var i = 0; i < n; i++) {
        var el = document.createElement('div'); el.className = 'label';
        el.innerHTML = '<div class="brand">TRAMO<br>SAN RAFAEL #1<small>— FUNDADORES —</small></div><div class="qr"></div>' +
          '<h1>Registra tu especiero</h1><p class="txt">Escanea con la cámara para agregarlo a tu cuenta y pedir repuestos de cada frasco.</p>' +
          '<div class="code">' + info.code + '</div><div class="meta">Especiero de ' + info.slots + ' frascos · Hecho a mano en Costa Rica</div>';
        sheet.appendChild(el);
        new QRCode(el.querySelector('.qr'), { text: url, width: 512, height: 512, colorDark: '#1f2a1e', colorLight: '#fffdf8', correctLevel: QRCode.CorrectLevel.M });
      }
    }
    var info = parse(new URLSearchParams(location.search).get('d'));
    if (!info) {
      document.getElementById('err').hidden = false;
      document.getElementById('paste').addEventListener('change', function (e) {
        try { var u = new URL(e.target.value.trim()); var d = u.searchParams.get('d'); if (parse(d)) location.search = '?d=' + encodeURIComponent(d); } catch (er) {}
      });
      return;
    }
    render(info);
    document.getElementById('copies').addEventListener('input', function () { render(info); });
  })();
  </script>
</body>
</html>
