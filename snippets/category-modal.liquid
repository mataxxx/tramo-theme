<div class="drawer drawer--category" id="CategoryModal" data-drawer="category" role="dialog" aria-modal="true" aria-label="Categoría" hidden>
  <div class="drawer__backdrop" data-drawer-close></div>
  <section class="category-modal"{% if settings.category_bg != blank %} style="--cat-bg: url('{{ settings.category_bg | image_url: width: 1400 }}'); --cat-bg-opacity: {{ settings.category_bg_opacity | default: 100 | divided_by: 100.0 }}"{% endif %} data-art="1">
    <header class="category-modal__head cm-hero">
      <div class="category-modal__art cm-hero__art" data-category-art aria-hidden="true">
        {%- if settings.category_banner != blank -%}
          {{ settings.category_banner | image_url: width: 1400 | image_tag: loading: 'lazy', alt: '' }}
        {%- endif -%}
      </div>
      <div class="cm-hero__copy">
        <h2 class="category-modal__title" data-category-modal-title></h2>
        <p class="cm-hero__sub">{{ settings.category_subtitle | default: 'Explora sabores, aromas y mezclas para tu cocina.' }}</p>
      </div>
      <div class="category-modal__tools cm-tools">
        <button type="button" class="icon-button category-modal__lupa" data-category-search-toggle aria-label="Buscar en la categoría" aria-expanded="true" hidden>{% render 'icon', name: 'search' %}</button>
        <button type="button" class="cm-btn" data-category-filters-toggle aria-expanded="true">{% render 'icon', name: 'filter' %}<span>Filtrar</span>{% render 'icon', name: 'chevron-down' %}</button>
        <div class="cm-sortwrap">
          <button type="button" class="cm-btn" data-category-filter-toggle aria-expanded="false">{% render 'icon', name: 'grid' %}<span>Ordenar</span>{% render 'icon', name: 'chevron-down' %}</button>
          <div class="search-sort cm-sortmenu" data-category-sort hidden>
            <button type="button" class="is-active" data-csort="default">Destacados</button>
            <button type="button" data-csort="title">A–Z</button>
            <button type="button" data-csort="price" data-label-asc="Precio ↑" data-label-desc="Precio ↓">Precio ↑</button>
          </div>
        </div>
        <button type="button" class="close-button close-button--static" data-drawer-close aria-label="Cerrar">{% render 'icon', name: 'close' %}</button>
      </div>
    </header>
    <div class="category-modal__filters cm-filters" data-category-filters>
      <div class="category-modal__chips" data-category-chips hidden></div>
    </div>
    <div class="category-modal__searchwrap" data-category-searchwrap>
      <div class="search-field category-modal__field">
        {% render 'icon', name: 'search' %}
        <input type="search" data-category-filter autocomplete="off" placeholder="Buscar..." aria-label="Buscar en la categoría">
      </div>
    </div>
    <div class="cm-bar">
      <span class="cm-count" data-category-count></span>
      <label class="cm-switch"><span>Disponible a granel</span><input type="checkbox" data-cat-granel><i></i></label>
      <label class="cm-switch"><span>Solo favoritos</span><input type="checkbox" data-cat-favs><i></i></label>
    </div>
    <div class="category-modal__body">
      <div class="category-modal__grid" data-category-grid></div>
      <p class="category-modal__empty" data-category-empty hidden>No encontramos productos con esa búsqueda.</p>
    </div>
  </section>
</div>
