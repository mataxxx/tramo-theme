{%- liquid
  assign og_title = page_title | default: shop.name
  if template.name == 'index'
    assign og_title = 'Tramo San Rafael #1 | Fundadores | Tienda Online'
  endif
  assign og_url = canonical_url
  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  endif
-%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
{%- assign og_desc = page_description | default: settings.seo_description -%}
{%- if og_desc != blank %}
  <meta property="og:description" content="{{ og_desc | strip_newlines | escape }}">
{%- endif -%}
{%- if page_image %}
  {%- comment -%} Imagen para WhatsApp/Facebook: https, liviana (WhatsApp ignora imágenes pesadas) {%- endcomment -%}
  {%- assign og_img = page_image | image_url: width: 900, format: 'pjpg' -%}
  <meta property="og:image" content="https:{{ og_img }}">
  <meta property="og:image:secure_url" content="https:{{ og_img }}">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="900">
  {%- if page_image.aspect_ratio %}<meta property="og:image:height" content="{{ 900 | divided_by: page_image.aspect_ratio | round }}">{% endif %}
  <meta property="og:image:alt" content="{{ og_title | escape }}">
  <meta name="twitter:image" content="https:{{ og_img }}">
{%- endif -%}
{%- if request.page_type == 'product' %}
  <meta property="og:price:amount" content="{{ product.price | divided_by: 100 }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
