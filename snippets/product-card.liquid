{%- comment -%}
  Tarjeta de producto. Parámetros: product, show_quick_add (bool), lazy (bool)
  Si el producto se vende a granel, muestra primero el precio por kilo. Si no, "Desde" + la presentación más barata.
{%- endcomment -%}
{%- liquid
  assign pick = nil
  assign min_price = 0
  assign max_price = 0
  assign counted = 0
  for v in product.variants
    assign v_is_bulk = false
    if v.options contains settings.bulk_variant_name
      assign v_is_bulk = true
    endif
    if v_is_bulk == false
      assign counted = counted | plus: 1
      if counted == 1 or v.price < min_price
        assign min_price = v.price
      endif
      if v.price > max_price
        assign max_price = v.price
      endif
      if v.available
        if pick == nil or v.price < pick.price
          assign pick = v
        endif
      endif
    endif
  endfor
  assign first_variant = product.selected_or_first_available_variant
  assign shown = pick | default: first_variant
  assign shown_is_bulk = false
  if shown.options contains settings.bulk_variant_name
    assign shown_is_bulk = true
  endif
  assign bulk_variant = nil
  for v in product.variants
    if v.options contains settings.bulk_variant_name
      if bulk_variant == nil or v.price < bulk_variant.price
        assign bulk_variant = v
      endif
    endif
  endfor
  assign per_kg = 1000 | divided_by: settings.bulk_unit_grams | default: 100
  assign show_from = false
  assign subtitle = ''
  if bulk_variant != nil
    assign subtitle = 'A granel o en bolsa'
    if counted == 0
      assign subtitle = 'A granel'
    endif
  elsif product.variants.size > 1
    assign show_from = true
    assign subtitle = 'Varias presentaciones'
  elsif product.has_only_default_variant == false
    assign subtitle = shown.title
  endif
-%}
<article class="product-card{% unless product.available %} product-card--sold-out{% endunless %}" data-product-card>
  <a href="{{ product.url }}" class="product-card__media" data-quick-view="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {%- if product.featured_media -%}
      {{
        product.featured_media
        | image_url: width: 600
        | image_tag:
          widths: '240, 360, 480, 600',
          sizes: '(min-width: 750px) 290px, 45vw',
          loading: 'lazy',
          alt: product.featured_media.alt
      }}
      {%- if product.media.size > 1 -%}
        {{ product.media[1].preview_image | image_url: width: 600 | image_tag: widths: '240, 360, 480, 600', sizes: '(min-width: 750px) 290px, 45vw', loading: 'lazy', alt: '', class: 'product-card__alt' }}
      {%- endif -%}
    {%- else -%}
      <div class="product-card__placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
    {%- endif -%}
    {%- unless product.available -%}
      <span class="badge">Agotado</span>
    {%- elsif product.compare_at_price > product.price -%}
      <span class="badge badge--sale">Oferta</span>
    {%- endunless -%}
  </a>

  <button type="button" class="like-btn" data-like="{{ product.handle }}" aria-pressed="false" aria-label="Guardar {{ product.title | escape }} en favoritos">{% render 'icon', name: 'heart' %}</button>

  <div class="product-card__info">
    <h3 class="product-card__title">
      <a href="{{ product.url }}" data-quick-view="{{ product.url }}">{{ product.title }}</a>
    </h3>
    {%- if subtitle != blank -%}
      <p class="product-card__subtitle">{{ subtitle }}</p>
    {%- endif -%}
    <div class="product-card__row">
      <div class="price{% if shown.compare_at_price > shown.price %} price--sale{% endif %}" data-price>
        {%- if product.price_max == 0 -%}
          <span class="price__soon">Precio pronto</span>
        {%- elsif bulk_variant != nil -%}
          <strong class="price__current">{{ bulk_variant.price | times: per_kg | money }}</strong><span class="price__unit">/ kg</span>
        {%- else -%}
        {%- if show_from or product.tags contains 'especiero-modelo' -%}<span class="price__from">Desde</span>{%- endif -%}
        {%- if shown.compare_at_price > shown.price -%}<s class="price__compare">{{ shown.compare_at_price | money }}</s>{%- endif -%}
        <strong class="price__current">{{ shown.price | money }}</strong>
        {%- endif -%}
      </div>
      {%- if show_quick_add and settings.card_quick_add and product.available and product.price_max > 0 -%}
        {%- if product.has_only_default_variant or shown_is_bulk == false -%}
          <button
            type="button"
            class="quick-add"
            data-quick-add="{{ shown.id }}"
            aria-label="Agregar {{ product.title | escape }} al carrito"
          >
            {% render 'icon', name: 'plus' %}
          </button>
        {%- else -%}
          <button
            type="button"
            class="quick-add"
            data-quick-view="{{ product.url }}"
            aria-label="Elegir presentación de {{ product.title | escape }}"
          >
            {% render 'icon', name: 'plus' %}
          </button>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</article>
