{%- comment -%}
  Selector de opciones (presentaciones). Parámetros: product, form_id, section_id
{%- endcomment -%}
{%- unless product.has_only_default_variant -%}
  {%- assign notes_lines = product.metafields.custom.notas_opciones.value | default: '' | newline_to_br | split: '<br />' -%}
  <div class="variant-picker" data-variant-picker>
    {%- for option in product.options_with_values -%}
      {%- assign opt_index = forloop.index0 -%}
      <fieldset class="variant-picker__group" data-option-index="{{ opt_index }}">
        <legend class="variant-picker__label">{{ option.name }}</legend>
        <div class="variant-picker__values">
          {%- for value in option.values -%}
            {%- assign input_id = section_id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
            <input
              type="radio"
              class="pill-input"
              id="{{ input_id }}"
              name="{{ section_id }}-option-{{ option.position }}"
              value="{{ value | escape }}"
              form="{{ form_id }}"
              data-option-value
              {% if option.selected_value == value %}checked{% endif %}
            >
            <label for="{{ input_id }}" class="pill">{{ value }}</label>
          {%- endfor -%}
        </div>
        {%- if notes_lines.size > 0 -%}
          {%- for value in option.values -%}
            {%- assign key = value | append: ':' -%}
            {%- for line in notes_lines -%}
              {%- assign l = line | strip -%}
              {%- if l contains key -%}
                {%- assign head = l | slice: 0, key.size -%}
                {%- if head == key -%}
                  {%- assign note = l | remove_first: key | strip -%}
                  <p class="variant-picker__note" data-option-note="{{ value | escape }}"{% unless option.selected_value == value %} hidden{% endunless %}>{{ note | escape }}</p>
                  {%- break -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- endif -%}
      </fieldset>
    {%- endfor -%}
  </div>
{%- endunless -%}
