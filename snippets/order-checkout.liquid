{%- comment -%}
  Pedido por WhatsApp + SINPE Móvil (sin pago en línea). Se activa en Ajustes del tema → Pedidos por WhatsApp.
{%- endcomment -%}
{%- if settings.order_mode -%}
<div class="ord" data-order hidden role="dialog" aria-modal="true" aria-labelledby="OrdTitle"
  data-wa="{{ settings.order_whatsapp | remove: ' ' | remove: '-' | remove: '+' | escape }}"
  data-sinpe="{{ settings.order_sinpe_number | escape }}"
  data-sinpe-name="{{ settings.order_sinpe_name | escape }}"
  data-prefix="{{ settings.order_prefix | default: 'PED' | escape }}"
  data-shop="{{ shop.name | escape }}"
  data-pickup="{{ settings.order_pickup_place | escape }}"
  data-delivery="{{ settings.order_delivery_label | default: 'Envío por Uber Flash' | escape }}"
  data-lat="{{ settings.order_map_lat | default: '9.9349' }}"
  data-lng="{{ settings.order_map_lng | default: '-84.0789' }}"
  data-currency="{{ cart.currency.iso_code }}">
  <div class="ord__bg" data-order-close></div>
  <section class="ord__panel">
    <header class="ord__head">
      <h2 id="OrdTitle" data-order-title>Finalizar pedido</h2>
      <button type="button" class="ord__x" data-order-close aria-label="Cerrar">{% render 'icon', name: 'close' %}</button>
    </header>
    <div class="ord-prog" data-order-prog>
      <div class="ord-prog__bar"><i data-order-prog-fill></i></div>
      <ol class="ord-prog__steps">
        <li data-order-dot="2"><span>1</span>Datos</li>
        <li data-order-dot="3"><span>2</span>Entrega</li>
        <li data-order-dot="4"><span>3</span>Factura</li>
      </ol>
    </div>

    <div class="ord__body" data-order-body>
      {%- comment -%} Paso 1: resumen, datos y entrega {%- endcomment -%}
      <div class="ord__step" data-order-step="form">

        <div class="ord-page" data-order-page="2">
        <div class="ord-box">
          <h3 class="ord-h">¿A nombre de quién?</h3>
          <label class="ord-field"><span>Nombre</span><input type="text" data-order-name autocomplete="name" required placeholder="¿A nombre de quién?"></label>
          <label class="ord-field"><span>Teléfono / WhatsApp</span><input type="tel" data-order-phone autocomplete="tel" inputmode="tel" required placeholder="8888-8888"></label>
          <p class="ord-tip">Te escribimos a este número para confirmar tu pedido.</p>
        </div>
        </div>

        <div class="ord-page" data-order-page="3" hidden>
        <div class="ord-box">
          <h3 class="ord-h">¿Cómo lo recibes?</h3>
          <div class="ord-opts" role="radiogroup">
            <label class="ord-opt">
              <input type="radio" name="ord-delivery" value="pickup" data-order-mode>
              <span class="ord-opt__ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 10 5 4h14l2 6"/><path d="M4 10v10h16V10"/><path d="M3 10h18M9 20v-6h6v6"/></svg></span>
              <span class="ord-opt__txt"><b>Recoger en el Mercado Central</b><small>{{ settings.order_pickup_place }}</small></span>
              <em class="ord-opt__tag">Gratis</em>
            </label>
            <label class="ord-opt">
              <input type="radio" name="ord-delivery" value="delivery" data-order-mode>
              <span class="ord-opt__ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 16V7h11v9"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg></span>
              <span class="ord-opt__txt"><b>{{ settings.order_delivery_label | default: 'Envío por Uber Flash' }}</b><small>Elige tu ubicación en el mapa</small></span>
              <em class="ord-opt__tag ord-opt__tag--soft">Se cotiza</em>
            </label>
          </div>

          <div class="ord-pane" data-order-pane="pickup" hidden>
            {%- if settings.order_sinpe_number != blank -%}
            <div class="ord-sinpe-box">
              <p>Deposita el total al <b>SINPE Móvil</b>:</p>
              <p class="ord-sinpe-box__num"><b>{{ settings.order_sinpe_number }}</b>{%- if settings.order_sinpe_name != blank -%}<small>{{ settings.order_sinpe_name }}</small>{%- endif -%}</p>
              <button type="button" class="ord-copy" data-order-copy="{{ settings.order_sinpe_number | remove: '-' | remove: ' ' | escape }}">Copiar número</button>
              <p class="ord-sinpe-box__hint">Envíanos el comprobante por WhatsApp junto con tu pedido.</p>
            </div>
            {%- endif -%}
            <p class="ord-note">{{ settings.order_pickup_note }}</p>
          </div>

          <div class="ord-pane" data-order-pane="delivery" hidden>
            <div class="ord-mapbar">
              <form class="ord-find" data-order-find>
                {% render 'icon', name: 'search' %}
                <input type="search" data-order-find-q placeholder="Buscar dirección o lugar" autocomplete="off" aria-label="Buscar dirección">
                <button type="submit">Buscar</button>
              </form>
              <button type="button" class="ord-locate" data-order-locate><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.2"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/><circle cx="12" cy="12" r="7.5"/></svg><span>Usar mi ubicación</span></button>
            </div>
            <div class="ord-map" data-order-map aria-label="Mapa: toca para marcar tu ubicación"></div>
            <p class="ord-maphint" data-order-maphint>Toca el mapa o arrastra el pin hasta tu casa.</p>
            <label class="ord-field"><span>Otras señas <small>(opcional)</small></span><textarea data-order-notes rows="2" placeholder="Casa verde, portón negro, 2º piso…"></textarea></label>
            <p class="ord-note">{{ settings.order_delivery_note }}</p>
          </div>
        </div>
        </div>

        <div class="ord-page" data-order-page="4" hidden>
        <div class="ord-box">
          <h3 class="ord-h">¿Deseas factura electrónica?</h3>
          <div class="ord-yn" role="radiogroup">
            <label><input type="radio" name="ord-fe" value="no" data-order-fe checked><span>No</span></label>
            <label><input type="radio" name="ord-fe" value="si" data-order-fe><span>Sí, con factura</span></label>
          </div>
          <div class="ord-fe" data-order-fe-fields hidden>
            <label class="ord-field"><span>Tipo de cédula</span>
              <select data-order-fe-type>
                <option value="Física">Física</option>
                <option value="Jurídica">Jurídica</option>
                <option value="DIMEX">DIMEX</option>
                <option value="NITE">NITE</option>
              </select>
            </label>
            <label class="ord-field"><span>Número de cédula</span><input type="text" data-order-fe-id inputmode="numeric" placeholder="1-2345-6789"></label>
            <label class="ord-field"><span>Nombre o razón social</span><input type="text" data-order-fe-name autocomplete="organization" placeholder="Como aparece en Hacienda"></label>
            <label class="ord-field"><span>Correo para la factura</span><input type="email" data-order-fe-mail autocomplete="email" inputmode="email" placeholder="correo@ejemplo.com"></label>
          </div>
        </div>

        <div class="ord-box">
          <h3 class="ord-h">Tu pedido</h3>
          <ul class="ord-lines" data-order-lines></ul>
          <div class="ord-sub"><span>Subtotal</span><b data-order-subtotal></b></div>
        </div>
        <div class="ord-box ord-review" data-order-review></div>
        <p class="ord-paynote">{% render 'icon', name: 'phone' %}<span data-order-paytext>Pagas por <b>SINPE Móvil</b> antes de retirar o de enviar tu pedido. Te pasamos los datos y el total por WhatsApp.</span></p>
        </div>
        <p class="ord-err" data-order-err role="alert" hidden></p>
      </div>

      {%- comment -%} Paso 2: listo {%- endcomment -%}
      <div class="ord__step ord-done" data-order-step="done" hidden>
        <span class="ord-done__ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg></span>
        <h3>¡Pedido <span data-order-code></span> listo!</h3>
        <p data-order-done-text></p>
        <a class="button button--full ord-wa" data-order-resend target="_blank" rel="noopener">{% render 'icon', name: 'send' %}<span>Abrir WhatsApp otra vez</span></a>
        <button type="button" class="ord-link" data-order-close>Seguir comprando</button>
      </div>
    </div>

    <footer class="ord__foot" data-order-foot>
      <button type="button" class="ord-backbtn" data-order-prev hidden>{% render 'icon', name: 'arrow-left' %}<span>Atrás</span></button>
      <button type="button" class="button ord-next" data-order-next disabled><span data-order-next-label>Continuar</span>{% render 'icon', name: 'chevron-right' %}</button>
      <button type="button" class="button ord-send" data-order-send disabled hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21l1.6-4.8A8.5 8.5 0 1 1 8 19.4L3 21Z"/></svg><span data-order-send-label>Enviar pedido por WhatsApp</span></button>
    </footer>
  </section>
</div>
{%- endif -%}
