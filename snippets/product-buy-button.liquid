{%- comment -%}
  Formulario de compra. Parámetros: product, form_id, label (opcional)
{%- endcomment -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- if product.tags contains 'especiero-modelo' -%}
  <div class="rack-cta">
    <a class="button button--full" href="/pages/especiero?modelo={{ product.handle }}">{% render 'icon', name: 'mortar' %} Armar mi especiero</a>
    <p class="rack-cta__note">Base de madera hecha a mano en Costa Rica. Tú eliges las especias.</p>
  </div>
{%- else -%}

{% form 'product', product, id: form_id, class: 'buy-form', novalidate: 'novalidate', data-product-form: '' %}
  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id {% unless current_variant.available %}disabled{% endunless %}>
  <input type="hidden" name="quantity" value="1" data-quantity-field>
  {% render 'product-spice', product: product %}
  {%- if product.metafields.custom.peso_variable.value == true -%}
    <p class="var-note">{% render 'icon', name: 'scale' %}<span><b>Peso variable:</b> el precio es aproximado. Lo pesamos al preparar tu pedido y te confirmamos el total exacto por WhatsApp antes de pagar.</span></p>
  {%- endif -%}
  {%- if settings.order_mode -%}
    {%- if product.metafields.custom.sin_encomienda.value == true -%}
    <p class="pay-order">{% render 'icon', name: 'phone' %}<span>Paga por <b>SINPE Móvil</b> y coordina el envío por <b>Uber Flash</b> o retira en el <b>Mercado Central</b>.</span></p>
    <p class="ship-warn">{% render 'icon', name: 'truck' %}<span><b>No se envía por encomienda.</b> Este producto solo se entrega por Uber Flash o retiro en el Mercado Central.</span></p>
    {%- else -%}
    <p class="pay-order">{% render 'icon', name: 'phone' %}<span>Paga por <b>SINPE Móvil</b> y coordina el envío por <b>Uber Flash</b>, retira en el <b>Mercado Central</b> o te lo mandamos por <b>encomienda</b> a todo el país.</span></p>
    {%- endif -%}
  {%- endif -%}
  <button
    type="submit"
    class="button button--full"
    data-add-button
    {% unless current_variant.available and current_variant.price > 0 %}disabled{% endunless %}
  >
    <span data-add-label>
      {%- if current_variant.price == 0 -%}
        Precio próximamente
      {%- elsif current_variant.available -%}
        {{ label | default: 'Agregar al carrito' }}
      {%- else -%}
        Agotado
      {%- endif -%}
    </span>
    <span class="button__price" data-add-price>{% if current_variant.available and current_variant.price > 0 %}· {{ current_variant.price | money }}{% endif %}</span>
  </button>
  <p class="form-error" data-form-error role="alert" hidden></p>
{% endform %}
{%- unless settings.order_mode -%}{% render 'pay-methods', mode: 'sentence' %}{%- endunless -%}
{% render 'sticky-pay' %}
<div class="trust-bar trust-bar--sticky" data-sticky-trust hidden>
  <ul class="trust-bar__list" role="list">
    <li class="trust-bar__item">{% render 'icon', name: 'shield' %}<span>{{ settings.sticky_trust_1 | default: 'Compra segura' }}</span></li>
    <li class="trust-bar__item">{% render 'icon', name: 'truck' %}<span>{{ settings.sticky_trust_2 | default: 'Entrega rápida' }}</span></li>
  </ul>
</div>
{%- endif -%}
