{%- comment -%}
  Métodos de pago informativos (SINPE Móvil, transferencia, tarjeta). Se editan en Configuración del tema → Carrito.
{%- endcomment -%}
{%- if settings.order_mode -%}
  {%- if mode == 'sentence' -%}<p class="pay-sentence">Paga por <strong>SINPE Móvil</strong></p>{%- endif -%}
{%- elsif settings.show_pay_methods and settings.pay_methods != blank and mode == 'sentence' -%}
  {%- assign sm = settings.pay_methods | split: ',' -%}
  <p class="pay-sentence">{{ settings.pay_prefix | default: 'Paga en' }}
    {%- for m in sm %}
      {%- assign nm = m | strip -%}
      {%- if forloop.first %} {% elsif forloop.last %} ó {% else %}, {% endif -%}
      <strong>{{ nm }}</strong>
    {%- endfor -%}
  </p>
{%- elsif settings.show_pay_methods and settings.pay_methods != blank -%}
  <div class="pay-methods">
    {%- if settings.pay_methods_title != blank -%}<p class="pay-methods__title">{% render 'icon', name: 'lock' %} <span>{{ settings.pay_methods_title }}</span></p>{%- endif -%}
    <ul class="pay-methods__list" role="list">
      {%- assign methods = settings.pay_methods | split: ',' -%}
      {%- for m in methods -%}
        {%- assign name = m | strip -%}
        {%- assign low = name | downcase -%}
        {%- assign mi = 'tag' -%}
        {%- if low contains 'sinpe' -%}{%- assign mi = 'phone' -%}
        {%- elsif low contains 'transfer' or low contains 'banco' or low contains 'depósito' -%}{%- assign mi = 'bank' -%}
        {%- elsif low contains 'tarjeta' or low contains 'visa' or low contains 'master' -%}{%- assign mi = 'card' -%}
        {%- endif -%}
        {%- if name != blank -%}<li class="pay-methods__item{% if low contains 'sinpe' %} pay-methods__item--sinpe{% endif %}">{% render 'icon', name: mi %}<span>{{ name }}</span></li>{%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}
