{%- comment -%}
  Devuelve el video de una receta (artículo del blog).
  Parámetros: art (artículo), mode: 'reel' | 'tile' | 'hero' | 'poster'
{%- endcomment -%}
{%- liquid
  assign rv = art.metafields.custom.video.value
  assign ru = art.metafields.custom.video_url.value
  assign rposter = ''
  if art.image
    assign rposter = art.image | image_url: width: 900
  elsif rv != blank and rv.preview_image
    assign rposter = rv.preview_image | image_url: width: 900
  endif
  if ru != blank
    unless ru contains '//'
      if rposter == ''
        assign rposter = ru | replace: '.mp4', '-poster.jpg' | asset_url
      endif
      assign ru = ru | asset_url
    endunless
  endif
-%}
{%- case mode -%}
  {%- when 'poster' -%}{{ rposter }}
  {%- when 'tile' -%}
    {%- if rposter != '' -%}<img class="reel-tile__media" src="{{ rposter }}" alt="" loading="lazy">{%- elsif ru != blank -%}<video class="reel-tile__media" muted playsinline preload="metadata" src="{{ ru }}#t=0.1"></video>{%- else -%}<span class="reel-tile__media reel-tile__media--empty"></span>{%- endif -%}
  {%- else -%}
    {%- if rv != blank -%}
      <video class="{% if mode == 'hero' %}rcp-hero__video{% else %}reel__video{% endif %}" {% if mode == 'hero' %}controls{% else %}muted loop{% endif %} playsinline preload="{% if mode == 'hero' %}metadata{% else %}none{% endif %}"{% if rposter != '' %} poster="{{ rposter }}"{% endif %}>
        {%- for source in rv.sources -%}<source src="{{ source.url }}" type="{{ source.mime_type }}">{%- endfor -%}
      </video>
    {%- elsif ru != blank -%}
      <video class="{% if mode == 'hero' %}rcp-hero__video{% else %}reel__video{% endif %}" {% if mode == 'hero' %}controls{% else %}muted loop{% endif %} playsinline preload="{% if mode == 'hero' %}metadata{% else %}none{% endif %}"{% if rposter != '' %} poster="{{ rposter }}"{% endif %}>
        <source src="{{ ru }}" type="video/mp4">
      </video>
    {%- elsif rposter != '' -%}
      <img class="{% if mode == 'hero' %}rcp-hero__video{% else %}reel__video{% endif %}" src="{{ rposter }}" alt="" loading="lazy">
    {%- endif -%}
{%- endcase -%}
