<div class="drawer drawer--right drawer--sheet" id="QuickView" data-drawer="quick-view" role="dialog" aria-modal="true" aria-label="Detalle del producto" hidden>
  <div class="drawer__backdrop" data-drawer-close></div>
  <aside class="drawer__panel">
    <button type="button" class="quickview-back" data-quickview-back hidden>{% render 'icon', name: 'arrow-left' %}<span class="visually-hidden" data-quickview-back-label>Volver</span></button>
    <button type="button" class="close-button" data-drawer-close aria-label="Cerrar">{% render 'icon', name: 'close' %}</button>
    <div class="quick-view__body" data-quick-view-body></div>
  </aside>
</div>
