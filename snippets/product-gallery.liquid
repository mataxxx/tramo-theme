{%- comment -%} Galería del producto: fotos y videos deslizables con puntitos (estilo Instagram) y miniaturas abajo. Parámetros: product, sizes {%- endcomment -%}
{%- assign pg_ar = product.featured_media.preview_image.aspect_ratio | default: 1 -%}
<div class="product-gallery" data-gallery{% if product.tags contains 'Fondo claro' %} data-bg="claro"{% endif %}{% assign va = product.metafields.custom.ventana_ancha.value %}{% if va == true %} data-shape="wide"{% endif %}{% if product.metafields.custom.rotar_foto.value == true %} data-rotate{% endif %}{% unless product.metafields.custom.foto_flotante.value == false %} data-float{% endunless %} style="--pg-ar: {{ pg_ar }}{% if product.metafields.custom.foto_proporcion.value %}; --pg-ar-d: {{ product.metafields.custom.foto_proporcion.value }}{% endif %}{% if product.metafields.custom.img_scale.value %}; --img-scale: {{ product.metafields.custom.img_scale.value }}{% endif %}">
  <div class="product-gallery__frame">
    {%- if product.metafields.custom.peso_variable.value == true -%}
      <span class="var-badge" title="El precio es aproximado: lo pesamos al preparar tu pedido y te confirmamos el total exacto por WhatsApp antes de pagar.">{% render 'icon', name: 'scale' %}<span>Peso variable · precio aprox.</span></span>
    {%- endif -%}
    <div class="product-gallery__strip" data-gallery-strip>
      {%- for media in product.media -%}
        {%- assign fe_key = media.id | append: '' -%}{%- assign fe = product.metafields.custom.foto_escala.value[fe_key] -%}
        <div class="product-gallery__slide product-gallery__slide--blur{% if fe %} has-scale{% endif %}" data-media-id="{{ media.id }}" style="--pg-bg: url('{{ media.preview_image | image_url: width: 240 }}'){% if fe %}; --slide-scale: {{ fe }}{% endif %}">
          {%- liquid
            assign vl = ''
            assign vids = ''
            assign o1 = ''
            assign same = true
            assign cnt = 0
            for v in product.variants
              if v.featured_media.id == media.id
                assign cnt = cnt | plus: 1
                assign vids = vids | append: v.id | append: ','
                if cnt == 1
                  assign vl = v.title
                  assign o1 = v.option1
                elsif v.option1 != o1
                  assign same = false
                endif
              endif
            endfor
            if cnt > 1
              if same
                assign vl = o1
              else
                assign vl = ''
              endif
            endif
          -%}
          {%- if vl != '' and product.variants.size > 1 -%}<span class="pg-vlabel">{{ vl }}</span>{%- endif -%}
          {%- if vids != '' and product.variants.size > 1 -%}<i hidden data-slide-variants="{{ vids }}"></i>{%- endif -%}
          {%- if media.media_type == 'video' -%}
            {%- assign vsrc = nil -%}
            {%- for s in media.sources -%}
              {%- if s.mime_type == 'video/mp4' -%}
                {%- if vsrc == nil or s.height <= 1080 and s.height > vsrc.height -%}{%- assign vsrc = s -%}{%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            <video class="product-gallery__video" data-gallery-video muted autoplay loop playsinline webkit-playsinline preload="metadata" poster="{{ media.preview_image | image_url: width: 1100 }}" aria-label="{{ media.alt | default: product.title | escape }}">
              {%- if vsrc -%}<source src="{{ vsrc.url }}" type="video/mp4">{%- endif -%}
            </video>
          {%- else -%}
          {{ media.preview_image | image_url: width: 1100 | image_tag: widths: '450, 600, 800, 1100', sizes: sizes | default: '(min-width: 750px) 50vw, 100vw', loading: lazy | default: 'lazy', alt: media.alt | default: product.title }}
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="product-gallery__slide">
          <div class="product-card__placeholder">{% render 'product-placeholder' %}</div>
        </div>
      {%- endfor -%}
    </div>
    {%- if product.media.size > 1 -%}
      <button type="button" class="gallery-arrow gallery-arrow--prev" data-gallery-prev aria-label="Foto anterior" disabled><svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg></button>
      <button type="button" class="gallery-arrow gallery-arrow--next" data-gallery-next aria-label="Foto siguiente"><svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg></button>
    {%- endif -%}
    {%- if product.media.size > 1 -%}
      <div class="gallery-dots" data-gallery-dots>
        {%- for media in product.media -%}<button type="button" class="gallery-dot{% if forloop.first %} is-on{% endif %}" data-gallery-dot="{{ forloop.index0 }}" aria-label="Ver {{ forloop.index }} de {{ product.media.size }}"></button>{%- endfor -%}
      </div>
    {%- endif -%}
  </div>
  {%- if product.media.size > 1 -%}
    <ul class="product-gallery__thumbs" role="list">
      {%- for media in product.media -%}
        <li>
          <button type="button" class="thumb{% if forloop.first %} is-active{% endif %}" data-thumb="{{ media.id }}" aria-label="Ver imagen {{ forloop.index }}">
            {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
          </button>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
  {%- assign rinde = product.metafields.custom.rinde.value -%}
  {%- if rinde != blank -%}
    <div class="pg-rinde">{% render 'icon', name: 'cake' %}<span>{{ rinde | escape | newline_to_br }}</span></div>
  {%- endif -%}
</div>
