{%- comment -%} Galería del producto: fotos deslizables, flechas y miniaturas abajo. Parámetros: product, sizes {%- endcomment -%}
<div class="product-gallery" data-gallery>
  <div class="product-gallery__frame">
    <div class="product-gallery__strip" data-gallery-strip>
      {%- for media in product.media -%}
        <div class="product-gallery__slide product-gallery__slide--blur" data-media-id="{{ media.id }}" style="--pg-bg: url('{{ media.preview_image | image_url: width: 240 }}')">
          {{ media.preview_image | image_url: width: 1100 | image_tag: widths: '450, 600, 800, 1100', sizes: sizes | default: '(min-width: 750px) 50vw, 100vw', loading: lazy | default: 'lazy', alt: media.alt | default: product.title }}
        </div>
      {%- else -%}
        <div class="product-gallery__slide">
          <div class="product-card__placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        </div>
      {%- endfor -%}
    </div>
    {%- if product.media.size > 1 -%}
      <button type="button" class="gallery-arrow gallery-arrow--prev" data-gallery-prev aria-label="Foto anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg></button>
      <button type="button" class="gallery-arrow gallery-arrow--next" data-gallery-next aria-label="Foto siguiente"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button>
      <span class="gallery-count" data-gallery-count>1 / {{ product.media.size }}</span>
    {%- endif -%}
  </div>
  {%- if product.media.size > 1 -%}
    <ul class="product-gallery__thumbs" role="list">
      {%- for media in product.media -%}
        <li>
          <button type="button" class="thumb{% if forloop.first %} is-active{% endif %}" data-thumb="{{ media.id }}" aria-label="Ver imagen {{ forloop.index }}">
            {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
          </button>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>
