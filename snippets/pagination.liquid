{%- comment -%}
  Paginación. Parámetro: paginate (objeto del tag {% paginate %})
{%- endcomment -%}
{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="Paginación">
    <ul class="pagination__list">
      {%- if paginate.previous -%}
        <li><a class="pagination__link" href="{{ paginate.previous.url }}" aria-label="Página anterior">&larr;</a></li>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a class="pagination__link" href="{{ part.url }}">{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}
            <span class="pagination__link is-current" aria-current="page">{{ part.title }}</span>
          {%- else -%}
            <span class="pagination__gap">{{ part.title }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
      {%- if paginate.next -%}
        <li><a class="pagination__link" href="{{ paginate.next.url }}" aria-label="Página siguiente">&rarr;</a></li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
