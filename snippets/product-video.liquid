{%- comment -%}
  Video del producto: miniatura que se reproduce sola (sin sonido) y se agranda al tocarla, estilo TikTok.
  Parámetros: product, title
{%- endcomment -%}
{%- assign pvideo = product.metafields.custom.video.value -%}
{%- if pvideo != blank -%}
  <div class="pvideo pvideo--mini" data-pvideo>
    {%- if title != blank -%}<p class="pvideo__title">{{ title }}</p>{%- endif -%}
    <div class="pvideo__backdrop" data-pvideo-close></div>
    <div class="pvideo__phone">
      <video class="pvideo__video" playsinline loop muted autoplay preload="auto" poster="{{ pvideo.preview_image | image_url: width: 700 }}">
        {%- for source in pvideo.sources -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
      </video>
      <button type="button" class="pvideo__toggle" data-pvideo-toggle aria-label="Ver el video en grande">
        <span class="pvideo__play">{% render 'icon', name: 'play' %}</span>
      </button>
      <span class="pvideo__badge">{% render 'icon', name: 'play' %} Video</span>
      <button type="button" class="pvideo__close" data-pvideo-close aria-label="Cerrar video">{% render 'icon', name: 'close' %}</button>
      <button type="button" class="pvideo__mute" data-pvideo-mute aria-label="Sonido" aria-pressed="false">
        <span data-icon-sound hidden>{% render 'icon', name: 'sound' %}</span>
        <span data-icon-muted>{% render 'icon', name: 'mute' %}</span>
      </button>
      <div class="pvideo__bar"><span data-pvideo-progress></span></div>
    </div>
  </div>
{%- endif -%}
