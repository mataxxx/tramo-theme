{%- comment -%}
  Combo del producto. Parámetros: product, title, text, button_label
  Solo se dibuja si el producto tiene productos en el campo "combo_items".
{%- endcomment -%}
{%- liquid
  assign combo_items = product.metafields.custom.combo_items.value
  assign combo_pct = product.metafields.custom.combo_percent.value | default: 0
  assign combo_code = product.metafields.custom.combo_code.value
-%}
{%- if combo_items.size > 0 -%}
  {%- liquid
    assign combo_base = product.selected_or_first_available_variant
    assign combo_total = combo_base.price
    assign combo_ids = combo_base.id | prepend: '[{"id":' | append: ',"quantity":1}'
    for it in combo_items
      assign v = it.selected_or_first_available_variant
      assign combo_total = combo_total | plus: v.price
      assign combo_ids = combo_ids | append: ',{"id":' | append: v.id | append: ',"quantity":1}'
    endfor
    assign combo_ids = combo_ids | append: ']'
    assign combo_final = combo_total
    if combo_pct > 0 and combo_code != blank
      assign rest = 100 | minus: combo_pct
      assign combo_final = combo_total | times: rest | divided_by: 100
    endif
    assign combo_count = combo_items.size | plus: 1
  -%}
  <div class="combo" data-combo data-combo-items='{{ combo_ids }}' data-combo-code="{{ combo_code | escape }}" data-combo-title="{{ title | escape }}" data-combo-final="{{ combo_final }}" data-combo-count="{{ combo_count }}">
    <p class="combo__title">{% render 'icon', name: 'tag' %} {{ title }}</p>
    {%- if text != blank -%}<p class="combo__text muted small">{{ text }}</p>{%- endif -%}
    <ul class="combo__list" role="list">
      <li class="combo__item combo__item--base">
        <span class="combo__thumb">{%- if product.featured_media -%}{{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: product.title }}{%- endif -%}</span>
        <span class="combo__name">{{ product.title }}</span>
      </li>
      {%- for it in combo_items -%}
        <li class="combo__item">
          <span class="combo__plus" aria-hidden="true">+</span>
          <span class="combo__thumb">{%- if it.featured_media -%}{{ it.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: it.title }}{%- endif -%}</span>
          <a class="combo__name" href="{{ it.url }}">{{ it.title }}</a>
        </li>
      {%- endfor -%}
    </ul>
    <div class="combo__total">
      <span class="combo__prices">
        {%- if combo_final < combo_total -%}<s>{{ combo_total | money_without_trailing_zeros | replace: '₡ ', '₡' }}</s>{%- endif -%}
        <strong>{{ combo_final | money_without_trailing_zeros | replace: '₡ ', '₡' }}</strong>
        {%- if combo_final < combo_total -%}<em class="combo__badge">-{{ combo_pct }}%</em>{%- endif -%}
      </span>
      <button type="button" class="button" data-combo-add>{{ button_label }}</button>
    </div>
    {%- if request.design_mode and combo_pct > 0 and combo_code == blank -%}
      <p class="small muted">Falta el código de descuento del combo (campo "combo_code" del producto) para que el descuento se aplique.</p>
    {%- endif -%}
  </div>
{%- endif -%}
