{%- comment -%}
  Contenido del menú (se usa en el panel móvil ).
  Parámetros: s (ajustes de la sección encabezado), ctx ('drawer' o 'sidebar')
{%- endcomment -%}
{%- liquid
  assign menu_obj = s.menu
  assign image_pos = s.menu_image_position | default: 'top'
  assign has_image = false
  if s.menu_image != blank
    assign has_image = true
  endif
-%}

{%- if has_image and image_pos == 'top' -%}
  {% render 'menu-image', s: s %}
{%- endif -%}

<nav class="menu-list" aria-label="Menú principal">
  {%- if menu_obj != blank and menu_obj.links.size > 0 -%}
    <ul>
      {%- for link in menu_obj.links -%}
        {%- liquid
          assign skip = false
          if s.hide_home and link.type == 'frontpage_link'
            assign skip = true
          endif
          if s.hide_home and link.url == routes.root_url
            assign skip = true
          endif
          if s.hide_catalog and link.type == 'catalog_link'
            assign skip = true
          endif
          if s.hide_catalog and link.url == routes.all_products_collection_url
            assign skip = true
          endif
          if s.hide_contact and link.url contains '/pages/contact'
            assign skip = true
          endif
        -%}
        {%- unless skip -%}
          <li>
            <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- if link.links.size > 0 -%}
              <ul class="menu-list__sub">
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endunless -%}
      {%- endfor -%}
    </ul>
  {%- elsif request.design_mode -%}
    <p class="muted small">Elige un menú en la configuración del encabezado.</p>
  {%- endif -%}
</nav>

{%- if s.show_about -%}
  <button type="button" class="menu-about" data-open="about">
    <span class="menu-about__icon">{% render 'icon', name: 'info' %}</span>
    <span class="menu-about__text"><strong>{{ s.about_label | default: 'Quiénes somos' }}</strong></span>
    {% render 'icon', name: 'chevron-right' %}
  </button>
{%- endif -%}

{%- if s.show_account -%}
  <div class="menu-account">
    {%- if customer -%}
      <div class="menu-account__slot" data-account-slot></div>
    {%- else -%}
      <a href="{{ routes.storefront_login_url }}" class="button button--full">
        {% render 'icon', name: 'user' %} Iniciar sesión
      </a>
    {%- endif -%}
  </div>
{%- endif -%}

{%- if has_image and image_pos == 'bottom' -%}
  {% render 'menu-image', s: s %}
{%- endif -%}
