{%- comment -%} Ficha dentro de la ventana de categoría, con datos para ordenar y filtrar. Parámetro: product {%- endcomment -%}
{%- assign has_bulk = 0 -%}{%- assign sort_price = product.price_min -%}{%- assign per_kg = 1000 | divided_by: settings.bulk_unit_grams | default: 100 -%}{%- for v in product.variants -%}{%- assign vt = v.title | downcase -%}{%- if vt contains 'granel' -%}{%- assign has_bulk = 1 -%}{%- assign sort_price = v.price | times: per_kg -%}{%- endif -%}{%- endfor -%}
<div class="category-modal__item" data-handle="{{ product.handle }}" data-bulk="{{ has_bulk }}" data-title="{{ product.title | escape }}" data-price="{{ sort_price }}" data-tags="{{ product.tags | join: '|' | downcase | escape }}">
  {% render 'product-card', product: product, show_quick_add: false %}
</div>
