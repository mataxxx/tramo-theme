{%- comment -%}
  Precio de un producto. Parámetros: product, variant (opcional), prefix_from (opcional)
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign is_bulk = false
  if target.options contains settings.bulk_variant_name
    assign is_bulk = true
  endif
-%}
<div class="price{% if target.compare_at_price > target.price %} price--sale{% endif %}" data-price>
  {%- if product.tags contains 'especiero-modelo' -%}
    <span class="price__from">Desde</span>
  {%- elsif prefix_from and variant == blank and product.price_varies -%}
    <span class="price__from">Desde</span>
  {%- endif -%}
  {%- if target.compare_at_price > target.price -%}
    <s class="price__compare" data-price-compare>{{ target.compare_at_price | money }}</s>
  {%- endif -%}
  <strong class="price__current" data-price-current>
    {%- if variant == blank and product.price_varies and prefix_from -%}
      {{ product.price_min | money }}
    {%- elsif is_bulk -%}
      {%- assign per_kg = 1000 | divided_by: settings.bulk_unit_grams | default: 100 -%}
      {{ target.price | times: per_kg | money }}
    {%- else -%}
      {{ target.price | money }}
    {%- endif -%}
  </strong>
  {%- if is_bulk and variant != blank -%}
    <span class="price__unit">/ kg</span>
  {%- endif -%}
</div>
