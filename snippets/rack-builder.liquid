{%- comment -%}
  Arma tu especiero (constructor). Se usa en la ventana de la portada y en la página /pages/especiero.
  Parámetros opcionales: modal (true/false), models, classic, house, world (colecciones), extra (producto), engrave (producto)
{%- endcomment -%}
{%- liquid
  assign rb_models = models | default: collections['especieros']
  assign rb_classic = classic | default: collections['frontpage']
  assign rb_house = house | default: collections['condimentos-de-la-casa']
  assign rb_world = world | default: collections['condimentos-del-mundo']
  assign rb_extra = extra | default: all_products['frasco-especial']
  assign rb_engrave = engrave | default: all_products['grabado-personalizado']
  assign rb_extra_price = 50000
  if rb_extra != blank
    assign rb_extra_price = rb_extra.price
  endif
-%}
<div class="rb{% if modal %} rb--modal{% endif %}" data-rb data-currency="{{ cart.currency.iso_code }}" data-cart-url="{{ routes.cart_url }}">
  <header class="rb__top">
    <div class="rb__topline">
      <p class="rb__steplabel" data-rb-steplabel>Paso 1 de 3 · Elige tu modelo</p>
      {%- if modal -%}
        <button type="button" class="rb__x" data-rb-close aria-label="Cerrar">{% render 'icon', name: 'close' %}</button>
      {%- endif -%}
    </div>
    <div class="rb__progress" aria-hidden="true"><i data-rb-bar></i></div>
    <ol class="rb__dots" aria-hidden="true">
      <li class="is-on" data-rb-dot="1">Modelo</li>
      <li data-rb-dot="2">Frascos</li>
      <li data-rb-dot="3">Listo</li>
    </ol>
  </header>

  <div class="rb__body" data-rb-body>
    {%- comment -%} Paso 1: modelo {%- endcomment -%}
    <section class="rb__step is-on" data-rb-step="1">
      <h2 class="rb__title">Elige tu especiero</h2>
      <div class="rb__models">
        {%- for p in rb_models.products -%}
          {%- liquid
            assign slots = 6
            assign dims = ''
            for t in p.tags
              if t contains 'slots-'
                assign slots = t | remove: 'slots-' | plus: 0
              endif
              if t contains 'medidas:'
                assign dims = t | remove: 'medidas:'
              endif
            endfor
            assign d = dims | split: 'x'
          -%}
          <button type="button" class="rb-model" data-rb-model="{{ p.id }}"{% unless p.available %} disabled{% endunless %}>
            <span class="rb-model__img">
              {%- if p.featured_image -%}
                {{ p.featured_image | image_url: width: 700 | image_tag: widths: '350, 700', sizes: '(min-width: 750px) 300px, 45vw', loading: 'lazy', alt: p.title }}
              {%- else -%}
                {%- capture asset_name -%}especiero-{{ slots }}.jpg{%- endcapture -%}
                <img src="{{ asset_name | asset_url }}" alt="{{ p.title | escape }}" loading="lazy" width="600" height="600">
              {%- endif -%}
            </span>
            <span class="rb-model__name">{{ slots }} frascos</span>
            {%- if d.size == 3 -%}<span class="rb-model__dims">{{ d[0] }} × {{ d[1] }} × {{ d[2] }} cm</span>{%- endif -%}
            <span class="rb-model__price">{{ p.price | money_without_trailing_zeros }}</span>
          </button>
        {%- else -%}
          <p class="rb__empty">Agrega productos a la colección «Especieros» con la etiqueta slots-6, slots-12 o slots-18.</p>
        {%- endfor -%}
      </div>
      <p class="rb__craft">
        <img src="{{ 'handmade-seal.svg' | asset_url }}" alt="" width="40" height="40" loading="lazy">
        <span><b>Materiales premium, hechos a mano en Costa Rica.</b> Madera trabajada por artesanos y frascos de vidrio con tapa metálica.</span>
      </p>
    </section>

    {%- comment -%} Paso 2: llenar frascos {%- endcomment -%}
    <section class="rb__step" data-rb-step="2" hidden>
      <button type="button" class="rb__back" data-rb-go="1">{% render 'icon', name: 'arrow-left' %}<span>Cambiar modelo</span></button>
      <h2 class="rb__title">Llena tus frascos</h2>
      <p class="rb__hint">Toca un espacio vacío para elegir. Las clásicas van incluidas; las mezclas de la casa y especias del mundo suman <b>+{{ rb_extra_price | money_without_trailing_zeros }}</b> por frasco.</p>
      <div class="rb-rack" data-rb-rack>
        <div class="rb-rack__shelves" data-rb-slots></div>
        <div class="rb-rack__base"><span>TRAMO<br>SAN RAFAEL</span><svg viewBox="0 0 60 12" aria-hidden="true"><path d="M2 6h56M14 6c-3-4-7-4-9-2M14 6c-3 4-7 4-9 2M30 6c-3-4-7-4-9-2M30 6c-3 4-7 4-9 2M46 6c-3-4-7-4-9-2M46 6c-3 4-7 4-9 2"/></svg></div>
      </div>
      <div class="rb__tools">
        <button type="button" class="rb__link" data-rb-surprise>Llenar al azar</button>
        <button type="button" class="rb__link" data-rb-clear>Vaciar</button>
      </div>
    </section>

    {%- comment -%} Paso 3: resumen {%- endcomment -%}
    <section class="rb__step" data-rb-step="3" hidden>
      <button type="button" class="rb__back" data-rb-go="2">{% render 'icon', name: 'arrow-left' %}<span>Cambiar frascos</span></button>
      <h2 class="rb__title">Tu especiero</h2>
      <div class="rb-sum" data-rb-summary></div>
      {%- if rb_engrave != blank -%}
        <div class="rb-eng">
          <label class="rb-eng__check"><input type="checkbox" data-rb-eng> Grabar un nombre en la madera <b>+{{ rb_engrave.price | money_without_trailing_zeros }}</b></label>
          <input type="text" class="field" data-rb-eng-text maxlength="14" placeholder="Ej: Familia Mora" hidden>
        </div>
      {%- endif -%}
    </section>
  </div>

  <footer class="rb__bar" data-rb-footer hidden>
    <div class="rb__barinfo"><strong data-rb-total></strong><small data-rb-count></small></div>
    <button type="button" class="button" data-rb-next>Continuar</button>
  </footer>

  <div class="rb-pick" data-rb-picker hidden role="dialog" aria-modal="true" aria-label="Elegir especia">
    <div class="rb-pick__bg" data-rb-pick-close></div>
    <section class="rb-pick__panel">
      <header class="rb-pick__head">
        <h3 data-rb-pick-title>Frasco 1</h3>
        <button type="button" class="rb__x" data-rb-pick-close aria-label="Cerrar">{% render 'icon', name: 'close' %}</button>
      </header>
      <div class="rb-pick__tabs" role="tablist">
        <button type="button" class="is-on" data-rb-tab="classic" role="tab">Clásicas<small>Incluidas</small></button>
        <button type="button" data-rb-tab="house" role="tab">De la casa<small>+{{ rb_extra_price | money_without_trailing_zeros }}</small></button>
        <button type="button" data-rb-tab="world" role="tab">Del mundo<small>+{{ rb_extra_price | money_without_trailing_zeros }}</small></button>
      </div>
      <div class="search-field rb-pick__search">{% render 'icon', name: 'search' %}<input type="search" data-rb-search placeholder="Buscar especia…" autocomplete="off" aria-label="Buscar especia"></div>
      <div class="rb-pick__grid" data-rb-grid></div>
      <button type="button" class="rb-pick__remove" data-rb-remove hidden>Quitar este frasco</button>
      <footer class="rb-pick__foot" data-rb-pick-foot hidden>
        <span class="rb-pick__count" data-rb-pick-count></span>
        <button type="button" class="button rb-pick__done" data-rb-pick-done disabled>Listo</button>
      </footer>
    </section>
  </div>

  <script type="application/json" data-rb-data>
    {
      "extra": {% if rb_extra != blank %}{"variant": {{ rb_extra.selected_or_first_available_variant.id }}, "price": {{ rb_extra.price }}}{% else %}{"variant": null, "price": {{ rb_extra_price }}}{% endif %},
      "engrave": {% if rb_engrave != blank %}{"variant": {{ rb_engrave.selected_or_first_available_variant.id }}, "price": {{ rb_engrave.price }}}{% else %}null{% endif %},
      "models": [
        {%- for p in rb_models.products -%}
          {%- assign slots = 6 -%}
          {%- for t in p.tags -%}{%- if t contains 'slots-' -%}{%- assign slots = t | remove: 'slots-' | plus: 0 -%}{%- endif -%}{%- endfor -%}
          {"id": {{ p.id }}, "title": {{ p.title | json }}, "variant": {{ p.selected_or_first_available_variant.id }}, "price": {{ p.price }}, "slots": {{ slots }}}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "spices": [
        {%- assign rb_first = true -%}
        {%- assign rb_seen = ',' -%}
        {%- for grp in (1..3) -%}
          {%- liquid
            case grp
              when 1
                assign coll = rb_classic
                assign gname = 'classic'
              when 2
                assign coll = rb_house
                assign gname = 'house'
              else
                assign coll = rb_world
                assign gname = 'world'
            endcase
          -%}
          {%- for p in coll.products limit: 80 -%}
            {%- capture key -%},{{ p.id }},{%- endcapture -%}
            {%- unless rb_seen contains key -%}
              {%- assign rb_seen = rb_seen | append: p.id | append: ',' -%}
              {%- unless rb_first -%},{%- endunless -%}{%- assign rb_first = false -%}
              {%- assign art = p.metafields.custom.frasco.value -%}
              {"id": {{ p.id }}, "handle": {{ p.handle | json }}, "title": {{ p.title | json }}, "group": "{{ gname }}", "hot": {% if p.metafields.custom.picante.value %}true{% else %}false{% endif %}, "art": {% if art != blank %}{% if art.media_type == 'image' %}{{ art | image_url: width: 160 | json }}{% else %}{{ art.url | json }}{% endif %}{% else %}""{% endif %}}
            {%- endunless -%}
          {%- endfor -%}
        {%- endfor -%}
      ]
    }
  </script>
</div>
