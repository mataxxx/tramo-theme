[
  {
    "name": "theme_info",
    "theme_name": "Tramo",
    "theme_version": "1.0.0",
    "theme_author": "Tramo San Rafael",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/support"
  },
  {
    "name": "Colores",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Fondo de la página",
        "default": "#f7f3e9"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Fondo de tarjetas y paneles",
        "default": "#fffdf8"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Texto",
        "default": "#151914"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Texto secundario",
        "default": "#77786f"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Color principal (botones, hero)",
        "default": "#263d25"
      },
      {
        "type": "color",
        "id": "color_on_primary",
        "label": "Texto sobre color principal",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_line",
        "label": "Líneas y bordes",
        "default": "#e4dfd2"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Acento (ofertas, avisos)",
        "default": "#b94720"
      }
    ]
  },
  {
    "name": "Tipografía",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Fuente de títulos",
        "default": "lora_n4"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Fuente de texto",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "type_body_size",
        "label": "Tamaño base del texto",
        "min": 13,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 16
      }
    ]
  },
  {
    "name": "Diseño",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Ancho máximo de la página",
        "min": 1100,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1440
      },
      {
        "type": "range",
        "id": "radius_card",
        "label": "Redondeo de tarjetas",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 12
      },
      {
        "type": "range",
        "id": "radius_button",
        "label": "Redondeo de botones",
        "min": 0,
        "max": 30,
        "step": 2,
        "unit": "px",
        "default": 8
      }
    ]
  },
  {
    "name": "Logo e icono",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Icono de pestaña (favicon)",
        "info": "Cuadrado, mínimo 32 x 32 px."
      }
    ]
  },
  {
    "name": "Ventana del producto",
    "settings": [
      {
        "type": "paragraph",
        "content": "Esta es la ventana que se abre al tocar un producto. Aquí decides qué se muestra dentro."
      },
      {
        "type": "checkbox",
        "id": "quick_show_description",
        "label": "Mostrar descripción",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "quick_show_video",
        "label": "Mostrar video (si el producto lo tiene)",
        "default": true
      },
      {
        "type": "select",
        "id": "quick_video_position",
        "label": "Posición del video",
        "options": [
          {
            "value": "on_image",
            "label": "Miniatura sobre la foto (se agranda al tocarla)"
          },
          {
            "value": "before_description",
            "label": "Antes de la descripción"
          },
          {
            "value": "after_description",
            "label": "Después de la descripción"
          }
        ],
        "default": "on_image"
      },
      {
        "type": "text",
        "id": "quick_video_title",
        "label": "Título del video",
        "default": "Míralo en acción"
      },
      {
        "type": "checkbox",
        "id": "quick_show_combo",
        "label": "Mostrar combo (si el producto lo tiene)",
        "default": true
      },
      {
        "type": "text",
        "id": "quick_combo_title",
        "label": "Combo: título",
        "default": "Llévalo en combo"
      },
      {
        "type": "text",
        "id": "quick_combo_text",
        "label": "Combo: texto",
        "default": "Agrega todo junto y ahorra."
      },
      {
        "type": "text",
        "id": "quick_combo_button",
        "label": "Combo: texto del botón",
        "default": "Agregar combo"
      },
      {
        "type": "checkbox",
        "id": "quick_show_ask",
        "label": "Mostrar preguntas (IA y WhatsApp)",
        "default": true
      },
      {
        "type": "text",
        "id": "quick_ask_trigger",
        "label": "Texto del botón para preguntar",
        "default": "¿Preguntas sobre el producto? Haz clic aquí"
      },
      {
        "type": "text",
        "id": "quick_ask_title",
        "label": "Preguntas: título",
        "default": "Pregúntale a nuestra IA"
      },
      {
        "type": "text",
        "id": "quick_ask_text",
        "label": "Preguntas: texto",
        "default": "Resuelve tus dudas al instante, o envía tu pregunta por WhatsApp."
      },
      {
        "type": "text",
        "id": "quick_ask_placeholder",
        "label": "Preguntas: texto del campo",
        "default": "Ej: ¿Para qué sirve? ¿Cómo se usa?"
      },
      {
        "type": "text",
        "id": "quick_ask_button",
        "label": "Preguntas: texto del botón",
        "default": "Preguntar a la IA"
      },
      {
        "type": "text",
        "id": "quick_ask_chip_1",
        "label": "Pregunta sugerida 1",
        "default": "¿Cómo se usa?"
      },
      {
        "type": "text",
        "id": "quick_ask_chip_2",
        "label": "Pregunta sugerida 2",
        "default": "¿Con qué lo combino?"
      },
      {
        "type": "text",
        "id": "quick_ask_chip_3",
        "label": "Pregunta sugerida 3",
        "default": "¿Cómo se conserva?"
      },
      {
        "type": "text",
        "id": "quick_ask_endpoint",
        "label": "Dirección del asistente IA",
        "info": "Normalmente /apps/tramo/ai. Si la vacías, las preguntas van por WhatsApp.",
        "default": "/apps/tramo/ai"
      },
      {
        "type": "text",
        "id": "quick_ask_whatsapp",
        "label": "Texto del botón de WhatsApp",
        "default": "Enviar por WhatsApp"
      },
      {
        "type": "checkbox",
        "id": "quick_show_related",
        "label": "Mostrar relacionados (si el producto los tiene)",
        "default": true
      },
      {
        "type": "text",
        "id": "quick_related_title",
        "label": "Relacionados: título",
        "default": "También te puede gustar"
      },
      {
        "type": "checkbox",
        "id": "quick_show_full_link",
        "label": "Mostrar enlace \"Ver detalles completos\"",
        "default": false
      }
    ]
  },
  {
    "name": "Carrito",
    "settings": [
      {
        "type": "header",
        "content": "Al agregar un producto"
      },
      {
        "type": "checkbox",
        "id": "cart_popup",
        "label": "Mostrar aviso de producto agregado",
        "default": true
      },
      {
        "type": "text",
        "id": "popup_title",
        "label": "Título del aviso",
        "default": "Producto agregado al carrito"
      },
      {
        "type": "text",
        "id": "popup_view_cart",
        "label": "Texto del botón de carrito",
        "default": "Ver carrito"
      },
      {
        "type": "text",
        "id": "popup_buy_now",
        "label": "Texto del botón de comprar ahora",
        "default": "Comprar ya"
      },
      {
        "type": "text",
        "id": "popup_continue",
        "label": "Texto del botón de seguir",
        "default": "Seguir comprando"
      },
      {
        "type": "header",
        "content": "Comprar ahora y métodos de pago"
      },
      {
        "type": "checkbox",
        "id": "buy_now",
        "label": "Mostrar botón \"Comprar ahora\" en los productos",
        "info": "Agrega el producto y lleva directo al pago.",
        "default": true
      },
      {
        "type": "text",
        "id": "buy_now_label",
        "label": "Texto de comprar ahora",
        "default": "Comprar ya"
      },
      {
        "type": "checkbox",
        "id": "show_pay_methods",
        "label": "Mostrar métodos de pago en productos y carrito",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "require_pay_choice",
        "label": "Pedir elegir el método de pago antes de finalizar",
        "info": "En el carrito aparece \"Paso 1\" y el botón de finalizar se activa al elegir. La elección queda guardada en el pedido.",
        "default": true
      },
      {
        "type": "text",
        "id": "pay_step_title",
        "label": "Título del paso",
        "default": "Paso 1 · Elige cómo vas a pagar"
      },
      {
        "type": "text",
        "id": "pay_step_hint",
        "label": "Aviso mientras no elija",
        "default": "Elige un método para activar “Finalizar compra”."
      },
      {
        "type": "text",
        "id": "pay_methods_title",
        "label": "Título junto a los métodos en los productos (opcional)"
      },
      {
        "type": "header",
        "content": "Al tocar el botón +"
      },
      {
        "type": "text",
        "id": "choice_title",
        "label": "Pregunta",
        "default": "¿Deseas?"
      },
      {
        "type": "text",
        "id": "choice_buy",
        "label": "Botón 1",
        "default": "Comprar ya"
      },
      {
        "type": "text",
        "id": "choice_add",
        "label": "Botón 2",
        "default": "Agregar al carrito y seguir viendo"
      },
      {
        "type": "text",
        "id": "pay_methods",
        "label": "Métodos de pago (separados por coma)",
        "info": "Es solo informativo: activa cada método en Shopify → Configuración → Pagos.",
        "default": "SINPE Móvil, Transferencia, Tarjeta"
      },
      {
        "type": "header",
        "content": "Carrito"
      },
      {
        "type": "select",
        "id": "cart_type",
        "label": "Al abrir el carrito",
        "options": [
          {
            "value": "drawer",
            "label": "Abrir el carrito lateral"
          },
          {
            "value": "page",
            "label": "Ir a la página del carrito"
          }
        ],
        "default": "drawer"
      }
    ]
  },
  {
    "name": "Venta a granel",
    "settings": [
      {
        "type": "paragraph",
        "content": "El granel funciona con una variante cuyo precio es el de una unidad de peso (por ejemplo 10 g). La cantidad en el carrito son esas unidades, y el tema muestra gramos."
      },
      {
        "type": "text",
        "id": "bulk_variant_name",
        "label": "Nombre de la opción a granel",
        "default": "A granel",
        "info": "Debe coincidir exactamente con el valor de la opción en el producto."
      },
      {
        "type": "number",
        "id": "bulk_unit_grams",
        "label": "Gramos por unidad",
        "default": 10,
        "info": "El precio de la variante a granel debe ser el precio de esta cantidad de gramos."
      },
      {
        "type": "number",
        "id": "bulk_min_grams",
        "label": "Mínimo a granel (g)",
        "default": 250
      },
      {
        "type": "number",
        "id": "bulk_button_step",
        "label": "Salto de los botones + y − (g)",
        "default": 50
      }
    ]
  },
  {
    "name": "Redes sociales",
    "settings": [
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp (solo números, con código de país)",
        "info": "Ejemplo: 50688887777"
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "YouTube"
      }
    ]
  }
]
