<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {%- style -%}
      :root {
        --color-bg: {{ settings.color_background }};
        --color-text: {{ settings.color_text }};
        --color-primary: {{ settings.color_primary }};
        --color-on-primary: {{ settings.color_on_primary }};
        --color-line: {{ settings.color_line }};
      }
    {%- endstyle -%}
    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  </head>
  <body class="template-password">
    <main class="password-page">
      <h1>{{ shop.name }}</h1>
      {%- if shop.password_message != blank -%}
        <div class="rte">{{ shop.password_message }}</div>
      {%- endif -%}
      {% form 'storefront_password' %}
        {{ form.errors | default_errors }}
        <label for="Password" class="visually-hidden">Contraseña</label>
        <input type="password" name="password" id="Password" placeholder="Contraseña" class="field">
        <button type="submit" class="button">Entrar</button>
      {% endform %}
    </main>
    {{ content_for_layout }}
  </body>
</html>
