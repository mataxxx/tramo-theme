<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {%- liquid
      assign coll_blocked = false
      if settings.allowed_collections != blank
        assign coll_allow = settings.allowed_collections | remove: ' ' | split: ','
        if template.name == 'list-collections'
          assign coll_blocked = true
        elsif template.name == 'collection'
          unless coll_allow contains collection.handle
            assign coll_blocked = true
          endunless
        endif
      endif
    -%}
    {%- if coll_blocked -%}<meta http-equiv="refresh" content="0;url={{ routes.root_url }}"><script>location.replace({{ routes.root_url | json }});</script>{%- endif -%}
 {%- capture ecom_header_content -%}{%- render 'ecom_header' -%}{%- endcapture -%}{%- unless ecom_header_content contains 'Liquid error' -%}{{ ecom_header_content }}{%- endunless -%}
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- liquid
      assign seo_hide = false
      if collection and collection.metafields.seo.hidden.value == 1
        assign seo_hide = true
      endif
      if page and page.metafields.seo.hidden.value == 1
        assign seo_hide = true
      endif
      if product and product.metafields.seo.hidden.value == 1
        assign seo_hide = true
      endif
    -%}
    {%- if seo_hide -%}<meta name="robots" content="noindex">{%- endif -%}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32.png' | asset_url }}">
      <link rel="icon" type="image/png" sizes="192x192" href="{{ 'favicon-192.png' | asset_url }}">
    {%- endif -%}
    <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Página {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- assign seo_desc = page_description | default: settings.seo_description -%}
    {%- if seo_desc != blank -%}
      <meta name="description" content="{{ seo_desc | strip_newlines | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}
    {% render 'seo-schema' %}

    {{ content_for_header }}

    {%- style -%}
      {{ settings.type_heading_font | font_face: font_display: 'swap' }}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}

      :root {
        --color-bg: {{ settings.color_background }};
        --color-surface: {{ settings.color_surface }};
        --color-text: {{ settings.color_text }};
        --color-muted: {{ settings.color_muted }};
        --color-primary: {{ settings.color_primary }};
        --color-on-primary: {{ settings.color_on_primary }};
        --color-line: {{ settings.color_line }};
        --color-accent: {{ settings.color_accent }};
        --font-heading: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }}, Georgia, serif;
        --font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }}, Arial, sans-serif;
        --page-width: {{ settings.page_width }}px;
        --radius-card: {{ settings.radius_card }}px;
        --radius-button: {{ settings.radius_button }}px;
        --body-size: {{ settings.type_body_size | default: 16 }}px;
      }
    {%- endstyle -%}

    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <link rel="stylesheet" href="{{ 'blog.css' | asset_url }}">
    <script src="{{ 'blog.js' | asset_url }}" defer></script>
    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.TRAMO = {
        moneyFormat: {{ shop.money_format | replace: 'amount_with_comma_separator', 'amount_no_decimals_with_comma_separator' | replace: 'amount_with_space_separator', 'amount_no_decimals_with_space_separator' | replace: '₡ ', '₡' | json }},
        cartDrawer: {{ settings.cart_type | default: 'drawer' | json }},
        cartPopup: {{ settings.cart_popup | json }},
        loggedIn: {% if customer %}true{% else %}false{% endif %},
        loginUrl: {{ routes.account_login_url | json }},
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
          cartChange: {{ routes.cart_change_url | append: '.js' | json }},
          cartJson: {{ routes.cart_url | append: '.js' | json }},
          search: {{ routes.search_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | append: '.json' | json }}
        },
        bulk: {
          name: {{ settings.bulk_variant_name | default: 'A granel' | json }},
          unit: {{ settings.bulk_unit_grams | default: 10 | json }},
          min: {{ settings.bulk_min_grams | default: 250 | json }},
          step: {{ settings.bulk_button_step | default: 50 | json }}
        }
      };
    </script>
  </head>

  <body class="template-{{ template.name | handleize }}{% if settings.show_accounts == false %} no-accounts{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" tabindex="-1">
      {%- if request.page_type == 'index' -%}<h1 class="visually-hidden">{{ settings.seo_h1 | default: shop.name }}</h1>{%- endif -%}
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
    {% sections 'overlay-group' %}

    {% render 'quick-view-sheet' %}
    {% render 'cart-added-popup' %}
    {%- unless settings.show_accounts == false -%}{% render 'login-popup' %}{%- endunless -%}
    {% render 'quick-choice' %}
    {% render 'category-modal' %}
    {% render 'blog-modal' %}
    {%- if settings.order_mode -%}{% render 'order-checkout' %}{{ 'order.css' | asset_url | stylesheet_tag }}<script src="{{ 'order.js' | asset_url }}" defer></script>{%- endif -%}
    <div class="toast" data-toast role="status" aria-live="polite" hidden></div>
  {%- capture ecom_footer_content -%}{%- render 'ecom_footer' -%}{%- endcapture -%}{%- unless ecom_footer_content contains 'Liquid error' -%}{{ ecom_footer_content }}{%- endunless -%}</body>
</html>
